[Unit]
Description=plumOS Bubble boot-complete milestone
ConditionPathExists=/storage/plumos/boot-probe/enabled
Requires=plumos-boot-probe.service
After=plumos-boot-probe.service emustation.service
Before=miniplus.target

[Service]
Type=oneshot
ExecStart=/storage/plumos/boot-probe/bin/plumos-boot-probe-log --fat S90_BOOT_COMPLETE
RemainAfterExit=yes
[Install]
WantedBy=miniplus.target
