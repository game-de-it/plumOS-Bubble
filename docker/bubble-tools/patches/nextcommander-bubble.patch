+#ifdef PLUMOS_MF
+void Screen::nativeFlip()
+{
+    auto *native = static_cast<plumos_fbdev_renderer *>(native_renderer);
+    if (native == nullptr || surface == nullptr || native->mem == nullptr) {
+        return;
+    }
+    const int rows = std::min(surface->h, static_cast<int>(native->var.yres));
+    const int row_bytes = std::min(surface->w,
+        static_cast<int>(native->var.xres)) * 4;
+    const auto *source = static_cast<const unsigned char *>(surface->pixels);
+    for (int y = 0; y < rows; y++) {
+        std::memcpy(
+            native->mem + static_cast<long>(y) * native->fix.line_length,
+            source + static_cast<long>(y) * surface->pitch,
+            static_cast<size_t>(row_bytes));
+    }
+    if (!plumos_fbdev_present(native)) {
+        SDL_Log("MF DRM page flip failed");
+    }
+}
+
+void Screen::shutdown()
+{
+    auto *native = static_cast<plumos_fbdev_renderer *>(native_renderer);
+    if (native != nullptr) {
+        plumos_fbdev_renderer_shutdown(native);
+        std::free(native);
+        native_renderer = nullptr;
+    }
+    if (surface != nullptr) {
+        SDL_FreeSurface(surface);
+        surface = nullptr;
+    }
+}
+#endif
+
 int Screen::onResize(int w, int h)
 {
 #ifdef USE_SDL2
+#ifdef PLUMOS_MF
+    (void)w;
+    (void)h;
+    return 0;
+#else
     this->surface = SDL_GetWindowSurface(this->window);
     setPhysicalResolution(surface->w, surface->h);
+#endif
 #else
 #ifndef MIYOOMINI
     this->surface = SDL_GetVideoSurface();
