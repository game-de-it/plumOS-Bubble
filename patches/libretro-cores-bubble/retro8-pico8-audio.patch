+inline void DSP::phaserWave(uint32_t frequency, int16_t amplitude, int32_t position, int16_t* dest, size_t samples)
+{
+  for (size_t i = 0; i < samples; ++i)
+  {
+    const float advance = position * float(frequency) / rate;
+    const float t = std::fmod(advance, 1.0f);
+    const float k = std::fabs(2.0f * std::fmod(advance / 128.0f, 1.0f) - 1.0f);
+    const float u = std::fmod(t + 0.5f * k, 1.0f);
+    const float wave = (std::fabs(4.0f * u - 2.0f) -
+                        std::fabs(8.0f * t - 4.0f)) / 6.0f;
+    dest[i] += int16_t(amplitude * wave);
+    ++position;
+  }
+}
