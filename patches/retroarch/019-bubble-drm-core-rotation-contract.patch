+static void drm_set_rotation(void *data, unsigned rotation)
+{
+   struct drm_video *_drmvars = data;
+   settings_t *settings = config_get_ptr();
+   unsigned next_panel_rotation;
+   unsigned core_rotation;
+   unsigned next_rotation;
+
+   (void)rotation;
+   if (!_drmvars)
+      return;
+
+   next_panel_rotation = settings
+      ? (settings->uints.video_rotation & 3) : 0;
+   core_rotation = retroarch_get_core_requested_rotation() & 3;
+   next_rotation = (next_panel_rotation + 4 - core_rotation) & 3;
+   if (_drmvars->rotation == next_rotation &&
+       _drmvars->panel_rotation == next_panel_rotation)
+      return;
+
+   _drmvars->rotation = next_rotation;
+   _drmvars->panel_rotation = next_panel_rotation;
+   fprintf(stderr, "[DRM] Bubble rotations panel=%u core=%u content=%u.\n",
+         next_panel_rotation, core_rotation, next_rotation);
+   if (_drmvars->main_surface)
+   {
+      drm_surface_free(_drmvars, &_drmvars->main_surface);
+      _drmvars->core_width = 0;
+      _drmvars->core_height = 0;
+   }
+   if (_drmvars->menu_surface)
+   {
+      drm_surface_free(_drmvars, &_drmvars->menu_surface);
+      _drmvars->menu_active = false;
+   }
+}
