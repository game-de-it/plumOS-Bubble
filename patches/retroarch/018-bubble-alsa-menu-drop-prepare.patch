@@ -376,23 +376,27 @@
 static bool alsa_start(void *data, bool is_shutdown)
 {
    alsa_t *alsa = (alsa_t*)data;
+   int ret;
+
+   (void)is_shutdown;
    if (!alsa->is_paused)
       return true;
 
