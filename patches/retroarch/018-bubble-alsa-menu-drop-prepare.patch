 }
 
@@ -490,20 +494,26 @@
 static bool alsa_stop(void *data)
 {
    alsa_t *alsa = (alsa_t*)data;
+   int ret;
+
    if (alsa->is_paused)
-	  return true;
+      return true;
 
-   if (alsa->stream_info.can_pause
-         && !alsa->is_paused)
