#!/bin/sh
set -u

bb=/bin/busybox
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH HOME=/root HOSTNAME=plumos-bubble

mounted() {
    $bb grep -qs " $1 " /proc/mounts 2>/dev/null
}

log() {
    message="plumos-bubble-init=$*"
    printf '%s\n' "$message" >/dev/console 2>/dev/null || true
    printf '%s\n' "$message" >/dev/kmsg 2>/dev/null || true
    if [ -d /storage/plumos/logs ] && [ -w /storage/plumos/logs ]; then
        printf '%s\n' "$message" >>/storage/plumos/logs/minimal-init.log 2>/dev/null || true
    fi
}

fat_stage() {
    stage=$1
    mounted /flash || return 0
    if $bb mount -o remount,rw /flash 2>/dev/null; then
        $bb mkdir -p /flash/plumos-probe
        printf '%s\n' "$stage" >/flash/plumos-probe/system-stage.tmp 2>/dev/null || true
        $bb sync
        $bb mv -f /flash/plumos-probe/system-stage.tmp \
            /flash/plumos-probe/system-stage.txt 2>/dev/null || true
        $bb sync
        $bb mount -o remount,ro /flash 2>/dev/null || true
    fi
}

mounted /proc || $bb mount -t proc proc /proc 2>/dev/null || true
mounted /sys || $bb mount -t sysfs sysfs /sys 2>/dev/null || true
mounted /dev || $bb mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
$bb mkdir -p /dev/pts /dev/shm /run /tmp /root /flash /storage
mounted /dev/pts || $bb mount -t devpts devpts /dev/pts 2>/dev/null || true
$bb mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run 2>/dev/null || true
$bb mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp 2>/dev/null || true
$bb hostname "$HOSTNAME" 2>/dev/null || true

log 'stage=S30_SYSTEM_ENTRY'
fat_stage S30_SYSTEM_ENTRY

if ! mounted /flash; then
    for device in /dev/mmcblk*p1; do
        [ -b "$device" ] || continue
        $bb mount -t vfat -o ro "$device" /flash 2>/dev/null && break
    done
fi
if ! mounted /storage; then
    for device in /dev/mmcblk*p2; do
        [ -b "$device" ] || continue
        $bb mount -t ext4 -o rw "$device" /storage 2>/dev/null && break
    done
fi

if mounted /storage; then
    $bb mkdir -p /storage/plumos/logs
    log 'stage=S31_STORAGE_MOUNTED'
else
    log 'stage=E31_STORAGE_NOT_MOUNTED'
fi
if mounted /flash; then
    log 'stage=S32_FLASH_MOUNTED'
    fat_stage S32_FLASH_MOUNTED
else
    log 'stage=E32_FLASH_NOT_MOUNTED'
fi

{
    echo '=== cmdline ==='
    cat /proc/cmdline 2>/dev/null || true
    echo '=== mounts ==='
    cat /proc/mounts 2>/dev/null || true
    echo '=== devices ==='
    ls -l /dev/mmcblk* /dev/fb* /dev/dri/* /dev/input/event* 2>/dev/null || true
    echo '=== kernel tail ==='
    dmesg 2>/dev/null | tail -200 || true
} >/storage/plumos/logs/minimal-snapshot.txt 2>/dev/null || true

if [ -c /dev/fb0 ] && [ -r /usr/share/plumos/bubble-s33-xrgb8888.raw ]; then
    $bb cat /usr/share/plumos/bubble-s33-xrgb8888.raw >/dev/fb0 2>/dev/null && {
        log 'stage=S33_FRAMEBUFFER_MARKER_DRAWN'
        fat_stage S33_FRAMEBUFFER_MARKER_DRAWN
    }
else
    log 'stage=E33_FRAMEBUFFER_UNAVAILABLE'
    fat_stage E33_FRAMEBUFFER_UNAVAILABLE
fi

log 'stage=S39_RECOVERY_IDLE_STORAGE_RO'
fat_stage S39_RECOVERY_IDLE_STORAGE_RO
$bb sync
if mounted /storage; then
    $bb mount -o remount,ro /storage 2>/dev/null || \
        log 'stage=E39_STORAGE_REMOUNT_RO_FAILED'
fi

exec $bb init
