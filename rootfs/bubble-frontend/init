#!/bin/sh
set -u

bb=/bin/busybox
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH HOME=/root HOSTNAME=plumos-bubble
network_stage_fat=1

mounted() {
    $bb grep -qs " $1 " /proc/mounts 2>/dev/null
}

log() {
    message="plumos-bubble-init=$*"
    printf '%s\n' "$message" >/dev/console 2>/dev/null || true
    printf '%s\n' "$message" >/dev/kmsg 2>/dev/null || true
    if [ -d /storage/plumos/logs ] && [ -w /storage/plumos/logs ]; then
        printf '%s\n' "$message" >>/storage/plumos/logs/minimal-init.log 2>/dev/null || true
    fi
}

fat_value() {
    name=$1
    value=$2
    mounted /flash || return 0
    if $bb mount -o remount,rw /flash 2>/dev/null; then
        $bb mkdir -p /flash/plumos-probe
        printf '%s\n' "$value" >"/flash/plumos-probe/$name.tmp" 2>/dev/null || true
        $bb sync
        $bb mv -f "/flash/plumos-probe/$name.tmp" \
            "/flash/plumos-probe/$name" 2>/dev/null || true
        $bb sync
        $bb mount -o remount,ro /flash 2>/dev/null || true
    fi
}

fat_stage() {
    fat_value system-stage.txt "$1"
}

network_stage() {
    stage=$1
    log "stage=$stage"
    [ "$network_stage_fat" -ne 1 ] || fat_stage "$stage"
}

start_recovery_network() {
    module=/lib/modules/4.19.193-g5a07852a55cf-dirty/kernel/drivers/net/wireless/rockchip_wlan/rkwifi/bcmdhd/bcmdhd.ko
    config=/storage/plumos/config/wpa_supplicant.conf
    host_key=/storage/plumos/ssh/dropbear_ed25519_host_key
    : >/run/plumos-wifi.log

    if [ -d /sys/class/net/wlan0 ]; then
        network_stage S34_WIFI_MODULE_ALREADY_ACTIVE
    elif [ -f "$module" ] && $bb insmod "$module" \
        firmware_path=/etc/firmware/fw_bcmdhd.bin \
        nvram_path=/etc/firmware/nvram.txt 2>/dev/null; then
        network_stage S34_WIFI_MODULE_LOADED
    else
        network_stage E34_WIFI_MODULE_LOAD_FAILED
        return 0
    fi

    count=0
    while [ ! -d /sys/class/net/wlan0 ] && [ "$count" -lt 50 ]; do
        $bb sleep 0.2
        count=$((count + 1))
    done
    if [ ! -d /sys/class/net/wlan0 ]; then
        network_stage E35_WIFI_INTERFACE_MISSING
        return 0
    fi
    settings=/storage/plumos/config/system/settings.json
    if [ -r "$settings" ] &&
        $bb grep -Eq '"wifi_enabled"[[:space:]]*:[[:space:]]*(false|0)' \
            "$settings" 2>/dev/null; then
        $bb ip link set wlan0 down >/dev/null 2>&1 || true
        network_stage S36_WIFI_DISABLED_BY_SETTING
        return 0
    fi
    if $bb ip link set wlan0 up >>/run/plumos-wifi.log 2>&1; then
        network_stage S35_WIFI_INTERFACE_READY
    else
        network_stage E35_WIFI_INTERFACE_UP_FAILED
        return 0
    fi

    if [ ! -s "$config" ]; then
        network_stage E36_WIFI_CONFIG_MISSING
        return 0
    fi
    $bb mkdir -p /run/wpa_supplicant
    if /usr/sbin/wpa_supplicant -B -P /run/wpa_supplicant.pid \
        -i wlan0 -D nl80211,wext -c "$config" \
        >>/run/plumos-wifi.log 2>&1; then
        network_stage S36_WPA_STARTED
    else
        network_stage E36_WPA_START_FAILED
        return 0
    fi

    count=0
    associated=false
    while [ "$count" -lt 60 ]; do
        wpa_status=$(/usr/sbin/wpa_cli -p /run/wpa_supplicant -i wlan0 status \
            2>>/run/plumos-wifi.log || true)
        if printf '%s\n' "$wpa_status" | $bb grep -q '^wpa_state=COMPLETED$'; then
            associated=true
            break
        fi
        if [ $((count % 10)) -eq 0 ]; then
            printf 'association_poll=%s\n%s\n' "$count" "$wpa_status" \
                >>/run/plumos-wifi.log
        fi
        $bb sleep 0.5
        count=$((count + 1))
    done
    if [ "$associated" != true ]; then
        network_stage E37_WIFI_ASSOCIATION_TIMEOUT
        return 0
    fi
    network_stage S37_WIFI_ASSOCIATED

    if ! $bb udhcpc -q -n -t 5 -T 3 -i wlan0 \
        -p /run/udhcpc-wlan0.pid -s /usr/share/udhcpc/default.script \
        >>/run/plumos-wifi.log 2>&1; then
        network_stage E38_DHCP_FAILED
        return 0
    fi
    address=$($bb ip -4 addr show dev wlan0 2>/dev/null | \
        $bb awk '/inet / { sub("/.*", "", $2); print $2; exit }')
    if [ -z "$address" ]; then
        network_stage E38_ADDRESS_MISSING
        return 0
    fi

    $bb mkdir -p /storage/plumos/ssh /run/dropbear /root/.ssh
    $bb chmod 0700 /storage/plumos/ssh /root/.ssh 2>/dev/null || true
    if [ ! -s "$host_key" ]; then
        /usr/bin/dropbearkey -t ed25519 -f "$host_key" \
            >>/run/dropbear/dropbear.log 2>&1 || {
            network_stage E38_SSH_HOST_KEY_FAILED
            return 0
        }
        $bb chmod 0600 "$host_key" 2>/dev/null || true
    fi
    if /usr/sbin/dropbear -E -P /run/dropbear/dropbear.pid \
        -r "$host_key" -p 22 -K 30 -I 300 \
        >>/run/dropbear/dropbear.log 2>&1; then
        log "stage=S38_RECOVERY_SSH_READY ip=$address port=22"
        fat_value network-address.txt "$address"
        fat_stage S38_RECOVERY_SSH_READY
    else
        network_stage E38_SSH_START_FAILED
    fi
}

capture_snapshot() {
    for runtime_log in plumos-wifi.log dropbear/dropbear.log; do
        [ -f "/run/$runtime_log" ] || continue
        destination=${runtime_log##*/}
        $bb cat "/run/$runtime_log" \
            >>"/storage/plumos/logs/$destination" 2>/dev/null || true
    done
    {
        echo '=== cmdline ==='
        cat /proc/cmdline 2>/dev/null || true
        echo '=== mounts ==='
        cat /proc/mounts 2>/dev/null || true
        echo '=== addresses ==='
        $bb ip addr 2>/dev/null || true
        echo '=== devices ==='
        ls -l /dev/mmcblk* /dev/fb* /dev/dri/* /dev/input/event* 2>/dev/null || true
        echo '=== processes ==='
        $bb ps w 2>/dev/null || true
        echo '=== kernel tail ==='
        dmesg 2>/dev/null | tail -240 || true
    } >/storage/plumos/logs/frontend-system-snapshot.txt 2>/dev/null || true
}

start_recovery_network_background() {
    network_stage_fat=0
    start_recovery_network
    capture_snapshot
    address=$($bb ip -4 addr show dev wlan0 2>/dev/null | \
        $bb awk '/inet / { sub("/.*", "", $2); print $2; exit }')
    result=ready
    [ -z "$address" ] || result=connected
    next=/run/plumos/network-boot/complete.next.$$
    {
        printf 'result=%s\n' "$result"
        printf 'ip=%s\n' "${address:-none}"
    } >"$next"
    $bb mv -f "$next" /run/plumos/network-boot/complete
    $bb rm -f /run/plumos/network-boot/in-progress
    log "stage=S38_RECOVERY_NETWORK_BACKGROUND_FINISHED result=$result ip=${address:-none}"
}

mounted /proc || $bb mount -t proc proc /proc 2>/dev/null || true
mounted /sys || $bb mount -t sysfs sysfs /sys 2>/dev/null || true
mounted /dev || $bb mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
$bb mkdir -p /dev/pts /dev/shm /run /tmp /root /flash /storage
mounted /dev/pts || $bb mount -t devpts devpts /dev/pts 2>/dev/null || true
$bb mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run 2>/dev/null || true
$bb mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp 2>/dev/null || true
$bb hostname "$HOSTNAME" 2>/dev/null || true

log 'stage=S30_SYSTEM_ENTRY'
fat_stage S30_SYSTEM_ENTRY

if ! mounted /flash; then
    for device in /dev/mmcblk*p1; do
        [ -b "$device" ] || continue
        $bb mount -t vfat -o ro "$device" /flash 2>/dev/null && break
    done
fi
if ! mounted /storage; then
    for device in /dev/mmcblk*p3; do
        [ -b "$device" ] || continue
        $bb mount -t ext4 -o rw "$device" /storage 2>/dev/null && break
    done
fi

if mounted /storage; then
    $bb mkdir -p /storage/plumos/logs
    log 'stage=S31_STORAGE_MOUNTED'
else
    log 'stage=E31_STORAGE_NOT_MOUNTED'
fi
if mounted /flash; then
    log 'stage=S32_FLASH_MOUNTED'
    fat_stage S32_FLASH_MOUNTED
else
    log 'stage=E32_FLASH_NOT_MOUNTED'
fi

if [ -c /dev/fb0 ] && [ -r /usr/share/plumos/bubble-s33-xrgb8888.raw ]; then
    $bb cat /usr/share/plumos/bubble-s33-xrgb8888.raw >/dev/fb0 2>/dev/null && {
        log 'stage=S33_FRAMEBUFFER_MARKER_DRAWN'
        fat_stage S33_FRAMEBUFFER_MARKER_DRAWN
    }
else
    log 'stage=E33_FRAMEBUFFER_UNAVAILABLE'
    fat_stage E33_FRAMEBUFFER_UNAVAILABLE
fi

$bb mkdir -p /run/plumos/network-boot
: >/run/plumos/network-boot/in-progress
log 'stage=S34_RECOVERY_NETWORK_BACKGROUND_DISPATCHED'
start_recovery_network_background &

if [ ! -f /storage/plumos/manifest.json ] || \
   [ ! -f /storage/plumos/checksums.sha256 ]; then
    log 'stage=E39_APP_LAYER_METADATA_MISSING'
    fat_stage E39_APP_LAYER_METADATA_MISSING
    exec $bb sh
fi
for required in \
    /storage/plumos/bin/plumos-frontend-launch \
    /storage/plumos/components/frontend/manifest.json \
    /storage/plumos/components/frontend/checksums.sha256; do
    if [ ! -s "$required" ]; then
        log "stage=E39_FRONTEND_REQUIRED_FILE_MISSING path=$required"
        fat_stage E39_FRONTEND_REQUIRED_FILE_MISSING
        exec $bb sh
    fi
done
if [ ! -x /storage/plumos/bin/plumos-frontend-launch ]; then
    log 'stage=E39_FRONTEND_LAUNCHER_NOT_EXECUTABLE'
    fat_stage E39_FRONTEND_LAUNCHER_NOT_EXECUTABLE
    exec $bb sh
fi
log 'stage=S39_APP_LAYER_METADATA_READY verification=build-update-deploy'
fat_stage S39_APP_LAYER_METADATA_READY

if [ -x /storage/plumos/bin/plumos-bubble-audio-init ]; then
    /storage/plumos/bin/plumos-bubble-audio-init || \
        log 'stage=E40_AUDIO_INIT_FAILED'
fi
log 'stage=S40_FRONTEND_SUPERVISOR_READY'
fat_stage S40_FRONTEND_SUPERVISOR_READY

restart_count=0
while :; do
    log "stage=S41_FRONTEND_START attempt=$restart_count"
    /bin/busybox sh /storage/plumos/bin/plumos-frontend-launch
    rc=$?
    log "stage=E80_FRONTEND_EXIT rc=$rc attempt=$restart_count"
    capture_snapshot
    restart_count=$((restart_count + 1))
    if [ "$restart_count" -ge 5 ]; then
        log 'stage=E81_FRONTEND_RESTART_LIMIT_RECOVERY_CONSOLE'
        fat_stage E81_FRONTEND_RESTART_LIMIT_RECOVERY_CONSOLE
        exec $bb sh
    fi
    $bb sleep 2
done
