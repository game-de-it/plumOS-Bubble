#!/bin/sh
set -eu

PLUMOS_ROOT=${PLUMOS_ROOT:-/storage/plumos}
PLUMOS_ROM_ROOT=${PLUMOS_ROM_ROOT:-/storage/Roms}
PLUMOS_BIOS_ROOT=${PLUMOS_BIOS_ROOT:-/storage/BIOS}
RUNTIME_ROOT=${PLUMOS_RUNTIME_ROOT:-/run/plumos}
BB=${PLUMOS_BUSYBOX:-/bin/busybox}
SYSTEM_ID=${PLUMOS_PICOARCH_SYSTEM:-unknown}
CORE_ID=${1:-}
CONTENT=${2:-}
PICOARCH=$PLUMOS_ROOT/picoarch/bin/picoarch
CORE=$PLUMOS_ROOT/cores/${CORE_ID}_libretro.so
LOG=$PLUMOS_ROOT/logs/picoarch-${SYSTEM_ID}-${CORE_ID}.log
CPU_CONTROL=$PLUMOS_ROOT/bin/plumos-cpu-control
PICOARCH_CONFIG=${PLUMOS_PICOARCH_CONFIG:-$PLUMOS_ROOT/config/standalone/picoarch.env}
[ ! -r "$PICOARCH_CONFIG" ] || . "$PICOARCH_CONFIG"
CPU_POLICY=${PLUMOS_PICOARCH_CPU_POLICY:-ondemand}
PICOARCH_EFFECT=${PLUMOS_PICOARCH_EFFECT:-NONE}
PICOARCH_VIDEO_DRIVER=${PLUMOS_PICOARCH_SDL_VIDEODRIVER:-dummy}
PICOARCH_AUDIO_DRIVER=${PLUMOS_PICOARCH_SDL_AUDIODRIVER:-alsa}
CPU_SNAPSHOT=$RUNTIME_ROOT/picoarch/cpu-governors.$$
CPU_SNAPSHOT_ACTIVE=0

[ "$#" -eq 2 ] || {
    echo 'plumos-picoarch-launch: core and content are required' >&2
    exit 2
}
case "$SYSTEM_ID:$CORE_ID" in
    *[!A-Za-z0-9._:-]*|*:)
        echo 'plumos-picoarch-launch: invalid system or core id' >&2
        exit 2
        ;;
esac
case "$CORE_ID" in
    flycast|flycast_xtreme|km_duckswanstation_xtreme_amped|mupen64plus_next|parallel_n64|yabasanshiro)
        echo "plumos-picoarch-launch: hardware-render core requires RetroArch: $CORE_ID" >&2
        exit 2
        ;;
esac
case "$CONTENT" in
    "$PLUMOS_ROM_ROOT"/*) ;;
    *) echo 'plumos-picoarch-launch: content escaped configured ROM root' >&2; exit 2 ;;
esac
[ -x "$PICOARCH" ] && [ -f "$CORE" ] && { [ -f "$CONTENT" ] || [ -d "$CONTENT" ]; } || {
    echo 'plumos-picoarch-launch: runtime, core, or content is missing' >&2
    exit 1
}
case "$CPU_POLICY" in
    interactive|performance|ondemand|schedutil|conservative) ;;
    *) echo "plumos-picoarch-launch: invalid CPU policy: $CPU_POLICY" >&2; exit 2 ;;
esac

$BB mkdir -p "$PLUMOS_ROOT/logs" "$PLUMOS_ROOT/state/picoarch/$SYSTEM_ID" \
    "$PLUMOS_ROOT/saves/$SYSTEM_ID" "$RUNTIME_ROOT/picoarch"
if [ -x "$PLUMOS_ROOT/bin/plumos-audio-output" ]; then
    "$BB" sh "$PLUMOS_ROOT/bin/plumos-audio-output" prepare >>"$LOG" 2>&1
    ALSA_CONFIG="$RUNTIME_ROOT/audio/asound.conf"
    [ -x "$PLUMOS_ROOT/bin/plumos-volume-control" ] &&
        "$BB" sh "$PLUMOS_ROOT/bin/plumos-volume-control" apply >>"$LOG" 2>&1 || true
else
    ALSA_CONFIG="$PLUMOS_ROOT/share/alsa/alsa.conf"
fi
RGB565_BYTESWAP=0
case "$CORE_ID" in
    mednafen_ngp|mednafen_supergrafx|mednafen_supafaust) RGB565_BYTESWAP=1 ;;
esac
SYSTEM_DIR=$PLUMOS_BIOS_ROOT
if [ "$CORE_ID" = scummvm ] && [ -f "$PLUMOS_ROOT/share/libretro-system/scummvm/extra/sky.cpt" ]; then
    SYSTEM_DIR=$PLUMOS_ROOT/share/libretro-system
fi

printf 'picoarch=stage-P10 system=%s core=%s\n' "$SYSTEM_ID" "$CORE_ID" \
    >>"$PLUMOS_ROOT/logs/session.log"
child=
stop_rc=
restore_cpu_policy() {
    if [ "$CPU_SNAPSHOT_ACTIVE" -eq 1 ]; then
        "$BB" sh "$CPU_CONTROL" restore "$CPU_SNAPSHOT" >/dev/null 2>&1 || true
        CPU_SNAPSHOT_ACTIVE=0
    fi
}
stop_child() {
    signal_rc=$1
    stop_rc=$signal_rc
    [ -n "$child" ] || return 0
    kill -TERM "$child" 2>/dev/null || return 0
    count=0
    while kill -0 "$child" 2>/dev/null && [ "$count" -lt 10 ]; do
        $BB usleep 100000
        count=$((count + 1))
    done
    kill -KILL "$child" 2>/dev/null || true
    restore_cpu_policy
}
trap 'stop_child 129' HUP
trap 'stop_child 130' INT
trap 'stop_child 143' TERM
if [ -x "$CPU_CONTROL" ] &&
    "$BB" sh "$CPU_CONTROL" snapshot "$CPU_SNAPSHOT"; then
    CPU_SNAPSHOT_ACTIVE=1
    "$BB" sh "$CPU_CONTROL" apply "$CPU_POLICY" || {
        restore_cpu_policy
        echo "plumos-picoarch-launch: cannot apply CPU policy: $CPU_POLICY" >&2
        exit 1
    }
else
    echo 'plumos-picoarch-launch: CPU policy control unavailable' >&2
    exit 1
fi
set +e
HOME="$PLUMOS_ROOT/state/picoarch/$SYSTEM_ID" \
PLUMOS_PICOARCH_SYSTEM="$SYSTEM_ID" \
PLUMOS_PICOARCH_SAVE_ROOT="$PLUMOS_ROOT/saves" \
PLUMOS_PICOARCH_BIOS_DIR="$SYSTEM_DIR" \
PLUMOS_PICOARCH_RGB565_BYTESWAP="$RGB565_BYTESWAP" \
SDL_VIDEODRIVER="$PICOARCH_VIDEO_DRIVER" \
SDL_AUDIODRIVER="$PICOARCH_AUDIO_DRIVER" \
PLUMOS_DRM_DEVICE=/dev/dri/card0 \
ALSA_CONFIG_PATH="$ALSA_CONFIG" \
LD_PRELOAD="${PLUMOS_DRM_SHARE_LIBRARY:-}" \
LD_LIBRARY_PATH="$PLUMOS_ROOT/picoarch/lib:$PLUMOS_ROOT/emulator/lib:/usr/lib" \
    "$PICOARCH" "$CORE" "$CONTENT" "$PICOARCH_EFFECT" >>"$LOG" 2>&1 &
child=$!
wait "$child"
rc=$?
set -e
if [ -n "$stop_rc" ]; then
    wait "$child" 2>/dev/null || true
    rc=$stop_rc
fi
trap - HUP INT TERM
restore_cpu_policy
printf 'picoarch=stage-P19 system=%s core=%s rc=%s\n' \
    "$SYSTEM_ID" "$CORE_ID" "$rc" >>"$PLUMOS_ROOT/logs/session.log"
$BB sync
exit "$rc"
