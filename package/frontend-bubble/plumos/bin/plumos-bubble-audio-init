#!/bin/sh
set -eu

PLUMOS_ROOT=${PLUMOS_ROOT:-/storage/plumos}
LOG=$PLUMOS_ROOT/logs/audio-init.log
if [ -x "$PLUMOS_ROOT/bin/plumos-audio-output" ] &&
   [ -x "$PLUMOS_ROOT/bin/plumos-volume-control" ]; then
    "$PLUMOS_ROOT/bin/plumos-audio-output" prepare >>"$LOG" 2>&1
    "$PLUMOS_ROOT/bin/plumos-volume-control" apply >>"$LOG" 2>&1
    echo 'audio_init=result-ok route=alsa-softvol' >>"$LOG"
else
    echo 'audio_init=result-skipped reason=managed-audio-helper-missing' >>"$LOG"
fi
