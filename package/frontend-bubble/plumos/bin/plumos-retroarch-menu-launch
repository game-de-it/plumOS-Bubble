#!/bin/sh
set -eu

PLUMOS_ROOT=${PLUMOS_ROOT:-/storage/plumos}
RUNTIME_ROOT=${PLUMOS_RUNTIME_ROOT:-/run/plumos}
BB=${PLUMOS_BUSYBOX:-/bin/busybox}
config=$PLUMOS_ROOT/config/retroarch/retroarch-bubble.cfg
factory=$PLUMOS_ROOT/factory-defaults/retroarch/retroarch-bubble.cfg
$BB mkdir -p "$PLUMOS_ROOT/config/retroarch" "$PLUMOS_ROOT/logs" \
    "$PLUMOS_ROOT/state/retroarch" "$RUNTIME_ROOT/retroarch"
if [ -x "$PLUMOS_ROOT/bin/plumos-retroarch-config-merge" ]; then
    "$PLUMOS_ROOT/bin/plumos-retroarch-config-merge" \
        >>"$PLUMOS_ROOT/logs/retroarch-config.log" 2>&1
elif [ ! -s "$config" ]; then
    $BB cp "$factory" "$config.next"
    $BB sync
    $BB mv "$config.next" "$config"
    $BB sync
fi
export LD_LIBRARY_PATH="$PLUMOS_ROOT/emulator/lib:$PLUMOS_ROOT/frontend/lib"
if [ -x "$PLUMOS_ROOT/bin/plumos-audio-output" ]; then
    "$BB" sh "$PLUMOS_ROOT/bin/plumos-audio-output" prepare \
        >>"$PLUMOS_ROOT/logs/retroarch-menu.log" 2>&1
    export ALSA_CONFIG_PATH="${PLUMOS_RUNTIME_ROOT:-/run/plumos}/audio/asound.conf"
    [ -x "$PLUMOS_ROOT/bin/plumos-volume-control" ] &&
        "$BB" sh "$PLUMOS_ROOT/bin/plumos-volume-control" apply \
        >>"$PLUMOS_ROOT/logs/retroarch-menu.log" 2>&1 || true
else
    export ALSA_CONFIG_PATH="$PLUMOS_ROOT/share/alsa/alsa.conf"
fi
export XDG_CONFIG_HOME="$PLUMOS_ROOT/config"
get_config_string() {
    key=$1
    "$BB" sed -n \
        "s/^${key}[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\"[[:space:]]*$/\\1/p" \
        "$config" | "$BB" tail -n 1
}
append_config=
cleanup() {
    [ -z "$append_config" ] || $BB rm -f "$append_config"
}
trap cleanup EXIT HUP INT TERM
if [ -n "${ALSA_CONFIG_PATH:-}" ] && [ -x "$PLUMOS_ROOT/bin/plumos-audio-output" ]; then
    append_config="$RUNTIME_ROOT/retroarch/menu.$$.cfg"
    printf '%s\n' 'audio_device = "plumos_output"' >"$append_config"
fi
case "$(get_config_string menu_driver)" in
    xmb|ozone)
        if [ -z "$append_config" ]; then
            append_config="$RUNTIME_ROOT/retroarch/menu.$$.cfg"
            : >"$append_config"
        fi
        printf '%s\n' 'video_driver = "gl"' >>"$append_config"
        printf '%s\n' 'video_context_driver = "kms"' >>"$append_config"
        ;;
esac
printf 'retroarch_menu=stage-S60 begin\n' >>"$PLUMOS_ROOT/logs/session.log"
set +e
set -- "$PLUMOS_ROOT/bin/retroarch" -v -c "$config"
[ -z "$append_config" ] || set -- "$@" --appendconfig "$append_config"
"$@" >>"$PLUMOS_ROOT/logs/retroarch-menu.log" 2>&1
rc=$?
set -e
printf 'retroarch_menu=stage-S69 end rc=%s\n' "$rc" >>"$PLUMOS_ROOT/logs/session.log"
cleanup
trap - EXIT HUP INT TERM
exit "$rc"
