#!/bin/sh
set -u

BB=${PLUMOS_BUSYBOX:-/bin/busybox}
DEVICE_OVERRIDE=${PLUMOS_SD2_DEVICE:-}
FALLBACK_DEVICE=${PLUMOS_SD2_FALLBACK_DEVICE:-/dev/mmcblk3p1}
REQUESTED_UUID=${PLUMOS_SD2_UUID:-}
REQUESTED_LABEL=${PLUMOS_SD2_LABEL:-}
SD2_MOUNT=${PLUMOS_SD2_MOUNTPOINT:-/run/media/sd2}
SD2_ACCESS=${PLUMOS_SD2_ACCESS:-rw}
USER_ROOT=${PLUMOS_USERDATA_ROOT:-/storage/user}
ROM_TARGET=${PLUMOS_ROM_BIND_TARGET:-$USER_ROOT/Roms}
BIOS_TARGET=${PLUMOS_BIOS_BIND_TARGET:-$USER_ROOT/BIOS}
RUNTIME_ROOT=${PLUMOS_RUNTIME_ROOT:-/run/plumos}
STATE_DIR=$RUNTIME_ROOT/sd2-content
IDENTITY_FILE=${PLUMOS_SD2_IDENTITY_FILE:-$USER_ROOT/config/system/sd2-identity.conf}
LOG=${PLUMOS_ROOT:-/storage/plumos}/logs/storage-health.log
MOUNTS_FILE=${PLUMOS_MOUNTS_FILE:-/proc/mounts}
DEVICE=
DEVICE_REASON=

case $SD2_ACCESS in
    rw|ro) ;;
    *)
        printf 'sd2_mount=result-refused reason=invalid-access access=%s\n' \
            "$SD2_ACCESS" >&2
        exit 2
        ;;
esac

log() {
    message=$1
    $BB mkdir -p "${LOG%/*}" 2>/dev/null || true
    printf '%s\n' "$message" | $BB tee -a "$LOG" >/dev/null 2>&1 || true
}

mount_source() {
    $BB awk -v path="$1" '$2 == path { print $1; exit }' "$MOUNTS_FILE" 2>/dev/null
}

is_mounted() {
    [ -n "$(mount_source "$1")" ]
}

identity_value() {
    key=$1
    [ -r "$IDENTITY_FILE" ] || return 1
    value=$($BB sed -n "s/^$key=//p" "$IDENTITY_FILE" 2>/dev/null | $BB head -n 1)
    case $value in
        ''|*[!A-Za-z0-9_.+-]*) return 1 ;;
    esac
    printf '%s\n' "$value"
}

find_identity() {
    kind=$1
    value=$2
    [ -n "$value" ] || return 1
    candidate=$($BB findfs "$kind=$value" 2>/dev/null) || return 1
    case $candidate in
        /dev/*) printf '%s\n' "$candidate" ;;
        *)
            if [ "${PLUMOS_SD2_TEST_ALLOW_REGULAR:-0}" = 1 ] &&
                [ -f "$candidate" ]; then
                printf '%s\n' "$candidate"
            else
                return 1
            fi
            ;;
    esac
}

device_disk() {
    candidate=$1
    case $candidate in
        */mmcblk*p[0-9]*) printf '%s\n' "${candidate%p*}" ;;
        /dev/sd*[0-9]) printf '%s\n' "$candidate" | $BB sed 's/[0-9][0-9]*$//' ;;
        *) printf '%s\n' "$candidate" ;;
    esac
}

device_available() {
    [ -b "$1" ] ||
        { [ "${PLUMOS_SD2_TEST_ALLOW_REGULAR:-0}" = 1 ] && [ -f "$1" ]; }
}

validate_device() {
    candidate=$1
    device_available "$candidate" || return 1
    storage_source=$(mount_source /storage)
    [ -z "$storage_source" ] || [ "$candidate" != "$storage_source" ] || return 1
    if [ -n "$storage_source" ] &&
        [ "$(device_disk "$candidate")" = "$(device_disk "$storage_source")" ]; then
        return 1
    fi
    return 0
}

resolve_device() {
    saved_uuid=$(identity_value uuid 2>/dev/null) || saved_uuid=
    saved_label=$(identity_value label 2>/dev/null) || saved_label=

    if [ -n "$DEVICE_OVERRIDE" ]; then
        candidate=$DEVICE_OVERRIDE
        reason=explicit-device
    elif candidate=$(find_identity UUID "${REQUESTED_UUID:-$saved_uuid}"); then
        reason=filesystem-uuid
    elif candidate=$(find_identity LABEL "${REQUESTED_LABEL:-$saved_label}"); then
        reason=filesystem-label
    else
        candidate=$FALLBACK_DEVICE
        reason=secondary-controller-fallback
    fi

    if ! validate_device "$candidate"; then
        printf 'sd2_resolve=result-refused reason=invalid-or-os-device device=%s selected_by=%s\n' \
            "$candidate" "$reason" >&2
        return 1
    fi
    DEVICE=$candidate
    DEVICE_REASON=$reason
    printf 'sd2_resolve=result-ok device=%s selected_by=%s\n' \
        "$DEVICE" "$DEVICE_REASON"
}

fat_uuid() {
    candidate=$1
    signature=$($BB dd if="$candidate" bs=1 skip=82 count=5 2>/dev/null)
    if [ "$signature" = FAT32 ]; then
        serial_offset=67
    else
        serial_offset=39
    fi
    serial=$($BB dd if="$candidate" bs=1 skip="$serial_offset" count=4 2>/dev/null |
        $BB od -An -tx1 | $BB tr -d ' \n')
    [ "${#serial}" -eq 8 ] || return 1
    printf '%s\n' "$serial" | $BB awk '{
        printf "%s%s-%s%s\n", substr($0,7,2), substr($0,5,2),
               substr($0,3,2), substr($0,1,2)
    }' | $BB tr 'a-f' 'A-F'
}

record_identity() {
    uuid=$(fat_uuid "$DEVICE" 2>/dev/null) || return 0
    label=${REQUESTED_LABEL:-}
    [ -n "$label" ] || label=$(identity_value label 2>/dev/null) || label=
    $BB mkdir -p "${IDENTITY_FILE%/*}" || return 1
    {
        printf 'uuid=%s\n' "$uuid"
        [ -z "$label" ] || printf 'label=%s\n' "$label"
        printf 'partition=1\n'
    } >"$IDENTITY_FILE.tmp" || return 1
    $BB chmod 0600 "$IDENTITY_FILE.tmp" 2>/dev/null || true
    $BB mv -f "$IDENTITY_FILE.tmp" "$IDENTITY_FILE" || return 1
    printf 'sd2_identity=result-saved uuid=%s label=%s device=%s\n' \
        "$uuid" "${label:-none}" "$DEVICE" | $BB tee -a "$LOG"
}

mount_access() {
    options=$($BB awk -v path="$1" '$2 == path { print $4; exit }' \
        "$MOUNTS_FILE" 2>/dev/null)
    case ",$options," in
        *,ro,*) printf 'ro\n' ;;
        *) printf 'rw\n' ;;
    esac
}

find_content_dir() {
    base=$1
    shift
    for name in "$@"; do
        [ -d "$base/$name" ] || continue
        printf '%s/%s\n' "$base" "$name"
        return 0
    done
    return 1
}

bind_content_dir() {
    source_dir=$1
    target_dir=$2
    label=$3
    sd2_source=$(mount_source "$SD2_MOUNT")
    current_source=$(mount_source "$target_dir")

    [ -n "$sd2_source" ] || return 1
    if [ -n "$current_source" ]; then
        if [ "$current_source" = "$sd2_source" ]; then
            source_access=$(mount_access "$SD2_MOUNT")
            target_access=$(mount_access "$target_dir")
            if [ "$target_access" != "$source_access" ]; then
                if ! $BB mount -o "remount,bind,$source_access" "$target_dir"; then
                    printf 'sd2_bind=result-remount-failed content=%s target=%s requested=%s retained=%s\n' \
                        "$label" "$target_dir" "$source_access" "$target_access" >&2
                    return 1
                fi
                printf 'sd2_bind=result-remounted content=%s target=%s access=%s\n' \
                    "$label" "$target_dir" "$source_access" | $BB tee -a "$LOG"
            else
                printf 'sd2_bind=result-already-mounted content=%s source=%s target=%s access=%s\n' \
                    "$label" "$source_dir" "$target_dir" "$source_access"
            fi
            return 0
        fi
        printf 'sd2_bind=result-refused reason=target-owned content=%s source=%s target=%s\n' \
            "$label" "$current_source" "$target_dir" >&2
        return 1
    fi

    $BB mkdir -p "$target_dir" "$STATE_DIR" || return 1
    if $BB mount --bind "$source_dir" "$target_dir"; then
        printf '%s\n' "$target_dir" >"$STATE_DIR/$label.target"
        access=$(mount_access "$SD2_MOUNT")
        printf 'sd2_bind=result-ok content=%s source=%s target=%s access=%s\n' \
            "$label" "$source_dir" "$target_dir" "$access" | $BB tee -a "$LOG"
        return 0
    fi
    printf 'sd2_bind=result-failed content=%s source=%s target=%s\n' \
        "$label" "$source_dir" "$target_dir" | $BB tee -a "$LOG" >&2
    return 1
}

unbind_content_dir() {
    target_dir=$1
    label=$2
    sd2_source=$(mount_source "$SD2_MOUNT")
    current_source=$(mount_source "$target_dir")

    if [ -z "$current_source" ]; then
        $BB rm -f "$STATE_DIR/$label.target" 2>/dev/null || true
        return 0
    fi
    if [ -z "$sd2_source" ] || [ "$current_source" != "$sd2_source" ]; then
        printf 'sd2_unbind=result-refused reason=foreign-mount content=%s source=%s target=%s\n' \
            "$label" "$current_source" "$target_dir" >&2
        return 1
    fi
    if $BB umount "$target_dir"; then
        $BB rm -f "$STATE_DIR/$label.target" 2>/dev/null || true
        printf 'sd2_unbind=result-ok content=%s target=%s fallback=sd1\n' \
            "$label" "$target_dir" | $BB tee -a "$LOG"
        return 0
    fi
    printf 'sd2_unbind=result-failed content=%s target=%s\n' \
        "$label" "$target_dir" | $BB tee -a "$LOG" >&2
    return 1
}

mount_sd2() {
    if ! resolve_device; then
        printf 'sd2_mount=result-unavailable fallback=sd1\n'
        return 2
    fi
    mounted_source=$(mount_source "$SD2_MOUNT")
    if [ -n "$mounted_source" ]; then
        if [ "$mounted_source" = "$DEVICE" ]; then
            current_access=$(mount_access "$SD2_MOUNT")
            if [ "$current_access" != "$SD2_ACCESS" ]; then
                if $BB mount -o "remount,$SD2_ACCESS" "$DEVICE" "$SD2_MOUNT"; then
                    printf 'sd2_mount=result-remounted device=%s target=%s access=%s\n' \
                        "$DEVICE" "$SD2_MOUNT" "$SD2_ACCESS" | $BB tee -a "$LOG"
                else
                    printf 'sd2_mount=result-remount-failed device=%s target=%s requested=%s retained=%s\n' \
                        "$DEVICE" "$SD2_MOUNT" "$SD2_ACCESS" "$current_access" | \
                        $BB tee -a "$LOG" >&2
                fi
            fi
            return 0
        fi
        printf 'sd2_mount=result-refused reason=target-owned source=%s target=%s\n' \
            "$mounted_source" "$SD2_MOUNT" >&2
        return 1
    fi

    $BB mkdir -p "$SD2_MOUNT" "${LOG%/*}"
    mount_options="$SD2_ACCESS,utf8,shortname=mixed,fmask=0022,dmask=0022,errors=remount-ro"
    if $BB mount -t vfat -o "$mount_options" "$DEVICE" "$SD2_MOUNT"; then
        access=$(mount_access "$SD2_MOUNT")
        printf 'sd2_mount=result-ok device=%s target=%s access=%s\n' \
            "$DEVICE" "$SD2_MOUNT" "$access" | $BB tee -a "$LOG"
        return 0
    fi
    if [ "$SD2_ACCESS" = rw ] &&
        $BB mount -t vfat -o ro,utf8,shortname=mixed,fmask=0022,dmask=0022,errors=remount-ro \
            "$DEVICE" "$SD2_MOUNT"; then
        printf 'sd2_mount=result-fallback device=%s target=%s requested=rw access=ro\n' \
            "$DEVICE" "$SD2_MOUNT" | $BB tee -a "$LOG" >&2
        return 0
    fi
    printf 'sd2_mount=result-failed device=%s target=%s\n' "$DEVICE" "$SD2_MOUNT" |
        $BB tee -a "$LOG" >&2
    return 1
}

start_sd2() {
    mount_rc=0
    mount_sd2 || mount_rc=$?
    [ "$mount_rc" -eq 0 ] || {
        [ "$mount_rc" -eq 2 ] && return 0
        return "$mount_rc"
    }
    record_identity || log 'sd2_identity=result-save-failed'

    rom_source=$(find_content_dir "$SD2_MOUNT" roms ROMS Roms) || rom_source=
    bios_source=$(find_content_dir "$SD2_MOUNT" bios BIOS Bios) || bios_source=
    result=0
    if [ -n "$rom_source" ]; then
        bind_content_dir "$rom_source" "$ROM_TARGET" roms || result=1
    else
        log 'sd2_bind=result-unavailable content=roms fallback=sd1'
    fi
    if [ -n "$bios_source" ]; then
        bind_content_dir "$bios_source" "$BIOS_TARGET" bios || result=1
    else
        log 'sd2_bind=result-unavailable content=bios fallback=sd1'
    fi
    access=$(mount_access "$SD2_MOUNT")
    printf 'sd2_content=result-started mount=%s roms=%s bios=%s access=%s\n' \
        "$SD2_MOUNT" "${rom_source:-sd1}" "${bios_source:-sd1}" "$access"
    return "$result"
}

stop_sd2() {
    result=0
    unbind_content_dir "$BIOS_TARGET" bios || result=1
    unbind_content_dir "$ROM_TARGET" roms || result=1
    if [ "$result" -ne 0 ]; then
        printf 'sd2_content=result-stop-refused reason=content-bind-active\n' >&2
        return 1
    fi
    if is_mounted "$SD2_MOUNT"; then
        $BB sync 2>/dev/null || true
        if $BB umount "$SD2_MOUNT"; then
            printf 'sd2_mount=result-unmounted target=%s fallback=sd1\n' "$SD2_MOUNT" |
                $BB tee -a "$LOG"
        else
            printf 'sd2_mount=result-unmount-failed target=%s\n' "$SD2_MOUNT" |
                $BB tee -a "$LOG" >&2
            return 1
        fi
    fi
    $BB rm -rf "$STATE_DIR" 2>/dev/null || true
    printf 'sd2_content=result-stopped fallback=sd1\n'
}

status_sd2() {
    sd2_source=$(mount_source "$SD2_MOUNT")
    rom_source=$(mount_source "$ROM_TARGET")
    bios_source=$(mount_source "$BIOS_TARGET")
    access=unmounted
    [ -z "$sd2_source" ] || access=$(mount_access "$SD2_MOUNT")
    resolved_device=unavailable
    resolved_by=none
    if resolve_device >/dev/null 2>&1; then
        resolved_device=$DEVICE
        resolved_by=$DEVICE_REASON
    fi
    printf 'sd2_mount=%s\nsd2_source=%s\nsd2_access=%s\nresolved_device=%s\nresolved_by=%s\nrom_target=%s\nrom_source=%s\nbios_target=%s\nbios_source=%s\n' \
        "$SD2_MOUNT" "${sd2_source:-unmounted}" "$access" \
        "$resolved_device" "$resolved_by" "$ROM_TARGET" \
        "${rom_source:-sd1}" "$BIOS_TARGET" "${bios_source:-sd1}"
}

case ${1:-start} in
    start) start_sd2 ;;
    stop) stop_sd2 ;;
    status) status_sd2 ;;
    *) printf 'Usage: plumos-bubble-mount-sd2 start|stop|status\n' >&2; exit 2 ;;
esac
