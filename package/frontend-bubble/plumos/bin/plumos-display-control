#!/bin/sh
set -u

PLUMOS_ROOT=${PLUMOS_ROOT:-/storage/plumos}
RUNTIME_ROOT=${PLUMOS_RUNTIME_ROOT:-/run/plumos}
SYSTEM_SETTINGS=${PLUMOS_SYSTEM_SETTINGS_JSON:-$PLUMOS_ROOT/config/system/settings.json}
RUNTIME_STATE=${PLUMOS_DISPLAY_RUNTIME_STATE:-$RUNTIME_ROOT/display/brightness}
LOG=${PLUMOS_DISPLAY_LOG:-$RUNTIME_ROOT/display/last-apply.log}
BACKLIGHT=${PLUMOS_BUBBLE_BACKLIGHT:-/sys/class/backlight/backlight/brightness}
MAX_BRIGHTNESS=${PLUMOS_BUBBLE_MAX_BRIGHTNESS:-${BACKLIGHT%/*}/max_brightness}
LEVEL_MAX=20
LEVEL_DEFAULT=10

mkdir -p "${RUNTIME_STATE%/*}" "${LOG%/*}" 2>/dev/null || true

usage() {
    printf '%s\n' \
        'Usage: plumos-display-control apply [1..20]|up|down|get|status' \
        '       plumos-display-control runtime-up|runtime-down|persist-runtime'
}

normalize() {
    value=${1:-}
    case "$value" in ''|*[!0-9]*) return 1 ;; esac
    value=$(printf '%s' "$value" | sed 's/^0*//')
    [ -n "$value" ] || value=1
    [ "$value" -ge 1 ] || value=1
    [ "$value" -le "$LEVEL_MAX" ] || value=$LEVEL_MAX
    printf '%s\n' "$value"
}

read_saved() {
    value=
    if [ -r "$SYSTEM_SETTINGS" ]; then
        value=$(sed -n 's/.*"brightness"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
            "$SYSTEM_SETTINGS" 2>/dev/null | head -n 1)
    fi
    normalize "${value:-$LEVEL_DEFAULT}" || printf '%s\n' "$LEVEL_DEFAULT"
}

read_runtime() {
    value=
    [ ! -r "$RUNTIME_STATE" ] ||
        value=$(sed -n '1s/^\([0-9][0-9]*\).*$/\1/p' "$RUNTIME_STATE" 2>/dev/null)
    case "$value" in ''|*[!0-9]*) read_saved ;; *) normalize "$value" ;; esac
}

write_runtime() {
    value=$(normalize "$1") || return 2
    next=$RUNTIME_STATE.next.$$
    printf '%s\n' "$value" >"$next" && mv -f "$next" "$RUNTIME_STATE" || {
        rm -f "$next"
        return 1
    }
}

write_saved() {
    value=$(normalize "$1") || return 2
    mkdir -p "${SYSTEM_SETTINGS%/*}" || return 1
    next=$SYSTEM_SETTINGS.next.$$
    if [ -r "$SYSTEM_SETTINGS" ] &&
        grep -q '"brightness"[[:space:]]*:' "$SYSTEM_SETTINGS" 2>/dev/null; then
        sed 's/"brightness"[[:space:]]*:[[:space:]]*[0-9][0-9]*/"brightness": '"$value"'/' \
            "$SYSTEM_SETTINGS" >"$next" || return 1
    else
        printf '{\n  "version": 1,\n  "brightness": %s\n}\n' "$value" >"$next" || return 1
    fi
    mv -f "$next" "$SYSTEM_SETTINGS"
}

raw_for_level() {
    case "$(normalize "$1")" in
        1) printf '1\n' ;; 2) printf '2\n' ;; 3) printf '3\n' ;;
        4) printf '4\n' ;; 5) printf '5\n' ;; 6) printf '7\n' ;;
        7) printf '10\n' ;; 8) printf '14\n' ;; 9) printf '20\n' ;;
        10) printf '28\n' ;; 11) printf '39\n' ;; 12) printf '52\n' ;;
        13) printf '68\n' ;; 14) printf '86\n' ;; 15) printf '106\n' ;;
        16) printf '128\n' ;; 17) printf '151\n' ;; 18) printf '177\n' ;;
        19) printf '205\n' ;; 20) printf '255\n' ;;
    esac
}

apply_level() {
    level=$(normalize "${1:-$(read_runtime)}") || return 2
    [ -w "$BACKLIGHT" ] || {
        printf 'backend=unavailable\npath=%s\n' "$BACKLIGHT" >"$LOG"
        return 1
    }
    raw=$(raw_for_level "$level")
    printf '%s\n' "$raw" >"$BACKLIGHT" || return 1
    write_runtime "$level" || return 1
    {
        printf 'backend=bubble-rk3566-backlight\n'
        printf 'brightness=%s\n' "$level"
        printf 'backlight_raw=%s\n' "$raw"
        [ ! -r "$MAX_BRIGHTNESS" ] || {
            printf 'max_brightness='
            cat "$MAX_BRIGHTNESS"
        }
    } >"$LOG"
}

change_runtime() {
    current=$(read_runtime)
    next=$((current + $1))
    [ "$next" -ge 1 ] || next=1
    [ "$next" -le "$LEVEL_MAX" ] || next=$LEVEL_MAX
    apply_level "$next"
}

change_saved() {
    current=$(read_saved)
    next=$((current + $1))
    [ "$next" -ge 1 ] || next=1
    [ "$next" -le "$LEVEL_MAX" ] || next=$LEVEL_MAX
    write_saved "$next" && apply_level "$next"
}

case ${1:-} in
    apply) apply_level "${2:-$(read_runtime)}" ;;
    up) change_saved 1 ;;
    down) change_saved -1 ;;
    runtime-up) change_runtime 1 ;;
    runtime-down) change_runtime -1 ;;
    persist-runtime) level=$(read_runtime); write_saved "$level"; sync ;;
    get) read_saved ;;
    status)
        [ -r "$BACKLIGHT" ] || exit 1
        printf 'backend=bubble-rk3566-backlight\n'
        printf 'brightness=%s\n' "$(read_runtime)"
        printf 'backlight_raw='; cat "$BACKLIGHT"
        [ ! -r "$MAX_BRIGHTNESS" ] || { printf 'max_brightness='; cat "$MAX_BRIGHTNESS"; }
        ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac
