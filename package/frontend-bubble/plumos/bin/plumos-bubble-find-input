#!/bin/sh
set -eu

BB=${PLUMOS_BUSYBOX:-/bin/busybox}
wanted=${1:-controller}
case "$wanted" in
    controller) name=retrogame_joypad ;;
    power) name='rk805 pwrkey' ;;
    volume) name=gpio-keys ;;
    *) echo "usage: $0 controller|power|volume" >&2; exit 2 ;;
esac

# BusyBox ash reads procfs one byte at a time for `read`; on this vendor
# 4.19 input proc file that can block before the first line.  Resolve the
# kernel input object through sysfs and only return an existing event node.
for input in /sys/class/input/input*; do
    [ -r "$input/name" ] || continue
    current=$($BB cat "$input/name" 2>/dev/null || true)
    [ "$current" = "$name" ] || continue
    for handler in "$input"/event*; do
        [ -e "$handler" ] || continue
        event=/dev/input/${handler##*/}
        [ -c "$event" ] || continue
        printf '%s\n' "$event"
        exit 0
    done
done
exit 1
