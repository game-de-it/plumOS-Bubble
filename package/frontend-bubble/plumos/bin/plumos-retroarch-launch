#!/bin/sh
set -eu

PLUMOS_ROOT=${PLUMOS_ROOT:-/storage/plumos}
PLUMOS_ROM_ROOT=${PLUMOS_ROM_ROOT:-/storage/Roms}
PLUMOS_BIOS_ROOT=${PLUMOS_BIOS_ROOT:-/storage/BIOS}
RUNTIME_ROOT=${PLUMOS_RUNTIME_ROOT:-/run/plumos}
BB=${PLUMOS_BUSYBOX:-/bin/busybox}
cpu_control=$PLUMOS_ROOT/bin/plumos-cpu-control
cpu_policy=ondemand
cpu_snapshot=
cpu_snapshot_active=0
system=
core=
rom=
no_content=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --system) system=$2; shift 2 ;;
        --core) core=$2; shift 2 ;;
        --rom) rom=$2; shift 2 ;;
        --no-content) no_content=1; shift ;;
        --cpu) cpu_policy=$2; shift 2 ;;
        --audio|--audio-latency|--safe-exit) shift 2 ;;
        --auto-state) shift ;;
        *) echo "plumos-retroarch-launch: unknown argument: $1" >&2; exit 2 ;;
    esac
done
case "$cpu_policy" in
    interactive|performance|ondemand|schedutil|conservative) ;;
    *) echo "invalid CPU policy: $cpu_policy" >&2; exit 2 ;;
esac
case "$system" in
    ''|*[!A-Za-z0-9._-]*) echo 'invalid system id' >&2; exit 2 ;;
esac
case "$core" in
    "$PLUMOS_ROOT"/cores/*_libretro.so) ;;
    *) echo 'core path escaped managed core directory' >&2; exit 2 ;;
esac
if { [ "$no_content" -eq 0 ] && [ -z "$rom" ]; } ||
   { [ "$no_content" -eq 1 ] && [ -n "$rom" ]; }; then
    echo 'exactly one of --rom or --no-content is required' >&2
    exit 2
fi
if [ "$no_content" -eq 0 ]; then
    case "$rom" in
        "$PLUMOS_ROM_ROOT"/*) ;;
        *) echo 'ROM path escaped configured ROM root' >&2; exit 2 ;;
    esac
fi
[ -f "$core" ] || exit 1
[ "$no_content" -eq 1 ] || [ -f "$rom" ] || exit 1
config=$PLUMOS_ROOT/config/retroarch/retroarch-bubble.cfg
factory=$PLUMOS_ROOT/factory-defaults/retroarch/retroarch-bubble.cfg
$BB mkdir -p "$PLUMOS_ROOT/config/retroarch" "$PLUMOS_ROOT/logs" \
    "$PLUMOS_ROOT/saves" "$PLUMOS_ROOT/states" \
    "$PLUMOS_ROOT/state/retroarch" "$RUNTIME_ROOT/retroarch"
if [ -x "$PLUMOS_ROOT/bin/plumos-retroarch-config-merge" ]; then
    "$PLUMOS_ROOT/bin/plumos-retroarch-config-merge" \
        >>"$PLUMOS_ROOT/logs/retroarch-config.log" 2>&1
elif [ ! -s "$config" ]; then
    $BB cp "$factory" "$config.next"
    $BB sync
    $BB mv "$config.next" "$config"
    $BB sync
fi
export LD_LIBRARY_PATH="$PLUMOS_ROOT/emulator/lib:$PLUMOS_ROOT/frontend/lib"
if [ -x "$PLUMOS_ROOT/bin/plumos-audio-output" ]; then
    "$BB" sh "$PLUMOS_ROOT/bin/plumos-audio-output" prepare \
        >>"$PLUMOS_ROOT/logs/retroarch-audio.log" 2>&1
    export ALSA_CONFIG_PATH="$RUNTIME_ROOT/audio/asound.conf"
    managed_audio_device=plumos_output
    [ -x "$PLUMOS_ROOT/bin/plumos-volume-control" ] &&
        "$BB" sh "$PLUMOS_ROOT/bin/plumos-volume-control" apply \
        >>"$PLUMOS_ROOT/logs/retroarch-audio.log" 2>&1 || true
else
    export ALSA_CONFIG_PATH="$PLUMOS_ROOT/share/alsa/alsa.conf"
fi
export XDG_CONFIG_HOME="$PLUMOS_ROOT/config"
get_config_string() {
    key=$1
    "$BB" sed -n \
        "s/^${key}[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\"[[:space:]]*$/\\1/p" \
        "$config" | "$BB" tail -n 1
}
core_id=${core##*/}
core_id=${core_id%_libretro.so}
menu_driver=$(get_config_string menu_driver)
append_config="$RUNTIME_ROOT/retroarch/launch.$$.cfg"
cpu_snapshot="$RUNTIME_ROOT/retroarch/cpu-governors.$$"
if [ -x "$cpu_control" ] &&
    "$BB" sh "$cpu_control" snapshot "$cpu_snapshot"; then
    cpu_snapshot_active=1
    "$BB" sh "$cpu_control" apply "$cpu_policy" || {
        "$BB" sh "$cpu_control" restore "$cpu_snapshot" >/dev/null 2>&1 || true
        cpu_snapshot_active=0
        echo "cannot apply CPU policy: $cpu_policy" >&2
        exit 1
    }
else
    echo 'CPU policy control unavailable' >&2
    exit 1
fi
case "$core_id:$menu_driver" in
    *:xmb|*:ozone|\
    flycast:*|flycast_xtreme:*|km_duckswanstation_xtreme_amped:*|\
    mupen64plus_next:*|parallel_n64:*|yabasanshiro:*)
        {
            printf '%s\n' 'video_driver = "gl"'
            printf '%s\n' 'video_context_driver = "kms"'
            printf '%s\n' 'video_threaded = "true"'
        } >"$append_config"
        ;;
    *)
        {
            # The Bubble plain-DRM backend blocks until the atomic page-flip
            # event arrives.  Run it on RetroArch's video thread so that wait
            # cannot starve the core/audio producer and underrun ALSA.
            printf '%s\n' 'video_driver = "drm"'
            printf '%s\n' 'video_context_driver = ""'
            printf '%s\n' 'video_threaded = "true"'
        } >"$append_config"
        ;;
esac
# The shared cfg keeps the V90S-compatible factory baseline, while Bubble may
# own BIOS on SD2. Resolve that active media root per launch without rewriting
# the user's persistent RetroArch configuration.
system_directory=$PLUMOS_BIOS_ROOT
case "$core_id" in
    bluemsx)
        managed_system="$PLUMOS_ROOT/share/libretro-system/bluemsx"
        if { [ ! -d "$PLUMOS_BIOS_ROOT/Databases" ] ||
             [ ! -d "$PLUMOS_BIOS_ROOT/Machines" ]; } &&
           [ -d "$managed_system/Databases" ] &&
           [ -d "$managed_system/Machines" ]; then
            system_directory=$managed_system
        fi
        ;;
esac
printf 'system_directory = "%s"\n' "$system_directory" >>"$append_config"
[ "$no_content" -eq 0 ] || \
    printf '%s\n' 'core_set_supports_no_game_enable = "true"' >>"$append_config"
# Keep each bounded route's verbose log in its route-specific file.  The
# shared plumOS cfg otherwise redirects every core into one retroarch.log,
# which makes mechanical per-core failure and geometry attribution ambiguous.
printf '%s\n' 'log_to_file = "false"' >>"$append_config"
# SD2 is intentionally mounted read-only after FAT corruption was detected.
# Keep save/state ownership in plumOS even though the shared cfg supports
# writable-media devices that place them beside content.
{
    printf '%s\n' 'savefiles_in_content_dir = "false"'
    printf '%s\n' 'savestates_in_content_dir = "false"'
    printf 'savefile_directory = "%s"\n' "$PLUMOS_ROOT/saves"
    printf 'savestate_directory = "%s"\n' "$PLUMOS_ROOT/states"
} >>"$append_config"
# The generated Bubble ALSA graph intentionally exposes only the managed
# softvol PCM.  Do not inherit the shared hw:0,0 setting, which both bypasses
# the zero-volume validation guard and is undefined in that bounded graph.
[ -z "${managed_audio_device:-}" ] || \
    printf 'audio_device = "%s"\n' "$managed_audio_device" >>"$append_config"
retroarch_pid=
cleanup() {
    [ -z "$append_config" ] || $BB rm -f "$append_config"
    if [ "$cpu_snapshot_active" -eq 1 ]; then
        "$BB" sh "$cpu_control" restore "$cpu_snapshot" >/dev/null 2>&1 || true
        cpu_snapshot_active=0
    fi
}
terminate_retroarch() {
    signal_rc=$1
    if [ -n "$retroarch_pid" ] && kill -0 "$retroarch_pid" 2>/dev/null; then
        kill -TERM "$retroarch_pid" 2>/dev/null || true
        terminate_wait=0
        while kill -0 "$retroarch_pid" 2>/dev/null && \
            [ "$terminate_wait" -lt 50 ]; do
            $BB usleep 100000
            terminate_wait=$((terminate_wait + 1))
        done
        kill -0 "$retroarch_pid" 2>/dev/null && \
            kill -KILL "$retroarch_pid" 2>/dev/null || true
        wait "$retroarch_pid" 2>/dev/null || true
    fi
    cleanup
    trap - EXIT HUP INT TERM
    exit "$signal_rc"
}
trap cleanup EXIT
trap 'terminate_retroarch 129' HUP
trap 'terminate_retroarch 130' INT
trap 'terminate_retroarch 143' TERM
printf 'retroarch_game=stage-S70 system=%s core=%s\n' "$system" "$core_id" >>"$PLUMOS_ROOT/logs/session.log"
set +e
set -- "$PLUMOS_ROOT/bin/retroarch" -v -c "$config"
[ -z "$append_config" ] || set -- "$@" --appendconfig "$append_config"
set -- "$@" -L "$core"
[ "$no_content" -eq 1 ] || set -- "$@" "$rom"
"$@" >>"$PLUMOS_ROOT/logs/retroarch-${system}-${core_id}.log" 2>&1 &
retroarch_pid=$!
wait "$retroarch_pid"
rc=$?
retroarch_pid=
set -e
printf 'retroarch_game=stage-S79 system=%s core=%s rc=%s\n' \
    "$system" "$core_id" "$rc" >>"$PLUMOS_ROOT/logs/session.log"
cleanup
trap - EXIT HUP INT TERM
exit "$rc"
