#!/bin/sh
set -eu

PLUMOS_ROOT=${PLUMOS_ROOT:-/storage/plumos}
RUNTIME_ROOT=${PLUMOS_RUNTIME_ROOT:-/run/plumos}
BB=${PLUMOS_BUSYBOX:-/bin/busybox}
LOG=$PLUMOS_ROOT/logs/frontend.log
VALIDATION_HOLD=${PLUMOS_FRONTEND_VALIDATION_HOLD:-$RUNTIME_ROOT/validation/frontend-hold}
UPDATE=$PLUMOS_ROOT/bin/plumos-system-update
UPDATE_LOG=$PLUMOS_ROOT/logs/system-update.log

$BB mkdir -p "$PLUMOS_ROOT/logs" "$RUNTIME_ROOT/frontend"
if [ -x "$UPDATE" ] &&
    { [ -s "$PLUMOS_ROOT/update-state/request.json" ] ||
      [ -s "$PLUMOS_ROOT/update-state/runtime-transaction.json" ] ||
      [ -s "$PLUMOS_ROOT/update-state/runtime-pending.json" ]; }; then
    printf 'frontend_update=apply-pending\n' >>"$LOG"
    PLUMOS_ROOT="$PLUMOS_ROOT" PLUMOS_USERDATA_ROOT=/storage/user \
        PLUMOS_BOOT_ROOT=/flash "$BB" sh "$UPDATE" apply-pending \
        >>"$UPDATE_LOG" 2>&1 ||
        printf 'frontend_update=apply-or-recovery-failed\n' >>"$LOG"
fi

SCAN_TIMEOUT=${PLUMOS_LIBRARY_SCAN_TIMEOUT:-180}
case "$SCAN_TIMEOUT" in *[!0-9]*|'') SCAN_TIMEOUT=180 ;; esac
export PLUMOS_ROOT PLUMOS_RUNTIME_ROOT="$RUNTIME_ROOT" PLUMOS_BUSYBOX="$BB"
# A root-only, tmpfs-backed hold gives device validation exclusive DRM/input
# ownership without replacing this managed launcher or fighting PID 1's normal
# frontend restart loop.  Removing the marker returns to the ordinary boot path.
if [ -e "$VALIDATION_HOLD" ]; then
    printf 'frontend_validation_hold=entered marker=%s\n' "$VALIDATION_HOLD" >>"$LOG"
    while [ -e "$VALIDATION_HOLD" ]; do
        "$BB" sleep 1
    done
    printf 'frontend_validation_hold=released marker=%s\n' "$VALIDATION_HOLD" >>"$LOG"
    exit 0
fi
if [ -x "$PLUMOS_ROOT/bin/plumos-bubble-mount-sd2" ]; then
    "$BB" sh "$PLUMOS_ROOT/bin/plumos-bubble-mount-sd2" start || true
fi
PLUMOS_SDCARD_ROOT=${PLUMOS_SDCARD_ROOT:-/storage}
PLUMOS_ROM_ROOT=${PLUMOS_ROM_ROOT:-/storage/Roms}
PLUMOS_BIOS_ROOT=${PLUMOS_BIOS_ROOT:-/storage/BIOS}
PLUMOS_IMAGE_ROOT=${PLUMOS_IMAGE_ROOT:-/storage/Images}
if [ -x "$PLUMOS_ROOT/bin/plumos-network-services" ]; then
    PLUMOS_ROOT="$PLUMOS_ROOT" PLUMOS_SDCARD_ROOT="$PLUMOS_SDCARD_ROOT" \
        "$BB" sh "$PLUMOS_ROOT/bin/plumos-network-services" start-enabled \
        >>"$PLUMOS_ROOT/logs/network-services.log" 2>&1 || true
    # PID 1 associates Wi-Fi in parallel with frontend startup.  FTP/SSH can
    # bind before an address exists, but Samba needs a usable interface.  Run
    # one bounded reconciliation after IPv4 appears so saved ON preferences
    # and runtime state cannot diverge without delaying the frontend.
    (
        attempts=0
        while [ "$attempts" -lt 30 ]; do
            if "$BB" ip -4 addr show scope global 2>/dev/null |
                "$BB" grep -q '^[[:space:]]*inet '; then
                PLUMOS_ROOT="$PLUMOS_ROOT" \
                    PLUMOS_SDCARD_ROOT="$PLUMOS_SDCARD_ROOT" \
                    "$BB" sh "$PLUMOS_ROOT/bin/plumos-network-services" \
                    start-enabled >>"$PLUMOS_ROOT/logs/network-services.log" 2>&1 || true
                printf 'network_services_reconcile=result-complete attempts=%s\n' \
                    "$attempts" >>"$PLUMOS_ROOT/logs/frontend.log"
                exit 0
            fi
            attempts=$((attempts + 1))
            "$BB" sleep 1
        done
        printf 'network_services_reconcile=result=timeout attempts=%s\n' \
            "$attempts" >>"$PLUMOS_ROOT/logs/frontend.log"
    ) &
fi
export PLUMOS_SDCARD_ROOT PLUMOS_ROM_ROOT
export PLUMOS_BIOS_ROOT PLUMOS_IMAGE_ROOT

$BB mkdir -p "$PLUMOS_ROOT/logs" "$RUNTIME_ROOT/frontend" \
    "$PLUMOS_ROOT/state/frontend" "$PLUMOS_ROOT/config/frontend" \
    "$PLUMOS_ROOT/config/system"
# Compatibility directories are best-effort seeds. SD2 is normally writable
# for the transfer services, but errors=remount-ro can protect a damaged FAT;
# either state must never prevent frontend startup.
case "$PLUMOS_ROM_ROOT" in /storage/*) $BB mkdir -p "$PLUMOS_ROM_ROOT/FC" 2>/dev/null || true ;; esac
case "$PLUMOS_BIOS_ROOT" in /storage/*) $BB mkdir -p "$PLUMOS_BIOS_ROOT" 2>/dev/null || true ;; esac
case "$PLUMOS_IMAGE_ROOT" in /storage/*) $BB mkdir -p "$PLUMOS_IMAGE_ROOT/nes" 2>/dev/null || true ;; esac
printf 'frontend_start=stage-S40 device=bubble renderer=software-drm\n' >>"$LOG"
printf 'frontend_media=sdcard_root=%s rom_root=%s bios_root=%s image_root=%s\n' \
    "$PLUMOS_SDCARD_ROOT" "$PLUMOS_ROM_ROOT" "$PLUMOS_BIOS_ROOT" \
    "$PLUMOS_IMAGE_ROOT" >>"$LOG"
if [ -x "$PLUMOS_ROOT/bin/plumos-storage-health" ]; then
    "$BB" sh "$PLUMOS_ROOT/bin/plumos-storage-health" observe >>"$LOG" 2>&1 ||
        printf 'frontend_storage_health=observe-failed\n' >>"$LOG"
fi

seed_default() {
    target=$1
    factory=$2
    if [ ! -s "$target" ]; then
        $BB cp "$factory" "$target.next"
        $BB sync
        $BB mv "$target.next" "$target"
        $BB sync
        printf 'frontend_default=seeded target=%s\n' "$target" >>"$LOG"
    else
        printf 'frontend_default=preserved target=%s\n' "$target" >>"$LOG"
    fi
}
seed_default "$PLUMOS_ROOT/config/frontend/settings.json" \
    "$PLUMOS_ROOT/factory-defaults/frontend/settings.json"
seed_default "$PLUMOS_ROOT/config/system/settings.json" \
    "$PLUMOS_ROOT/factory-defaults/system/settings.json"

# The volume and power keys must remain available while the frontend has
# released DRM and an emulator owns the display. The service is singleton and
# starts its evdev readers without delaying normal FE startup.
if [ -x "$PLUMOS_ROOT/bin/plumos-volume-keys-service" ]; then
    PLUMOS_ROOT="$PLUMOS_ROOT" PLUMOS_RUNTIME_ROOT="$RUNTIME_ROOT" \
        "$BB" sh "$PLUMOS_ROOT/bin/plumos-volume-keys-service" start \
        >>"$LOG" 2>&1 || printf 'volume_keys=start-failed\n' >>"$LOG"
fi

# PID 1 performs the first connection in the background.  If that worker has
# already finished without an address, retry in the background as well so an
# unavailable AP can never delay the frontend.
if [ -x "$PLUMOS_ROOT/bin/plumos-network-control" ]; then
    if ! $BB grep -Eq '"wifi_enabled"[[:space:]]*:[[:space:]]*(false|0)' \
            "$PLUMOS_ROOT/config/system/settings.json" 2>/dev/null && \
       ! "$BB" ip -4 addr show dev wlan0 2>/dev/null | $BB grep -q 'inet '; then
        if [ -e "$RUNTIME_ROOT/network-boot/in-progress" ]; then
            printf 'frontend_network=background-owner-system\n' >>"$LOG"
        else
            reconcile_lock=$RUNTIME_ROOT/network-reconcile.lock
            (
                if "$BB" mkdir "$reconcile_lock" 2>/dev/null; then
                    "$BB" sh "$PLUMOS_ROOT/bin/plumos-network-control" --wifi on \
                        >>"$LOG" 2>&1 || true
                    "$BB" rmdir "$reconcile_lock" 2>/dev/null || true
                fi
            ) &
            printf 'frontend_network=background-reconcile-dispatched\n' >>"$LOG"
        fi
    fi
fi

printf 'frontend_scan=stage-S41\n' >>"$LOG"
storage_result=$($BB awk -F= '$1 == "result" { print $2; exit }' \
    "$PLUMOS_ROOT/state/storage-health/status" 2>/dev/null || true)
if [ -s "$PLUMOS_ROOT/state/frontend/library-index.json" ] &&
    { [ "$storage_result" = dirty ] || [ "$storage_result" = inconsistent ]; }; then
    printf 'frontend_scan=skipped_dirty_media result=%s index=preserved\n' \
        "$storage_result" >>"$LOG"
else
    if PLUMOS_ROOT="$PLUMOS_ROOT" PLUMOS_SDCARD_ROOT="$PLUMOS_SDCARD_ROOT" \
        "$BB" timeout -s TERM -k 5 "$SCAN_TIMEOUT" \
        "$PLUMOS_ROOT/bin/plumos-library-scan" --defer-thumbnails >>"$LOG" 2>&1; then
        printf 'frontend_scan=complete timeout=%s\n' "$SCAN_TIMEOUT" >>"$LOG"
    else
        scan_rc=$?
        printf 'frontend_scan=bounded_failure rc=%s timeout=%s index=preserved\n' \
            "$scan_rc" "$SCAN_TIMEOUT" >>"$LOG"
    fi
fi
if [ -x "$PLUMOS_ROOT/bin/plumos-storage-health" ]; then
    "$BB" sh "$PLUMOS_ROOT/bin/plumos-storage-health" observe >>"$LOG" 2>&1 ||
        printf 'frontend_storage_health=post-scan-observe-failed\n' >>"$LOG"
fi
printf 'frontend_exec=stage-S42\n' >>"$LOG"
if [ -x "$UPDATE" ] && [ -s "$PLUMOS_ROOT/update-state/runtime-pending.json" ]; then
    $BB rm -f /tmp/plumos-fe-ready
    (
        attempts=0
        while [ "$attempts" -lt 60 ]; do
            if [ -s /tmp/plumos-fe-ready ]; then
                PLUMOS_ROOT="$PLUMOS_ROOT" PLUMOS_USERDATA_ROOT=/storage/user \
                    PLUMOS_BOOT_ROOT=/flash "$BB" sh "$UPDATE" mark-healthy \
                    >>"$UPDATE_LOG" 2>&1
                exit $?
            fi
            attempts=$((attempts + 1))
            $BB sleep 1
        done
        printf 'frontend_update=renderer-ready-timeout\n' >>"$UPDATE_LOG"
        exit 1
    ) &
fi
exec "$BB" sh "$PLUMOS_ROOT/bin/plumos-controller-ui-bubble" "$@" >>"$LOG" 2>&1
