#!/bin/sh
set -eu

PLUMOS_ROOT=${PLUMOS_ROOT:-/storage/plumos}
RUNTIME_ROOT=${PLUMOS_RUNTIME_ROOT:-/run/plumos}
BB=${PLUMOS_BUSYBOX:-/bin/busybox}
LOG=$PLUMOS_ROOT/logs/frontend.log
export PLUMOS_ROOT PLUMOS_RUNTIME_ROOT="$RUNTIME_ROOT"
if [ -z "${PLUMOS_SDCARD_ROOT:-}" ]; then
    if $BB grep -qs ' /run/media/sd2 ' /proc/mounts; then
        PLUMOS_SDCARD_ROOT=/run/media/sd2
    else
        PLUMOS_SDCARD_ROOT=/storage
    fi
fi
if [ -z "${PLUMOS_ROM_ROOT:-}" ]; then
    case "$PLUMOS_SDCARD_ROOT" in
        /run/media/sd2) PLUMOS_ROM_ROOT=$PLUMOS_SDCARD_ROOT ;;
        *) PLUMOS_ROM_ROOT=$PLUMOS_SDCARD_ROOT/Roms ;;
    esac
fi
export PLUMOS_SDCARD_ROOT PLUMOS_ROM_ROOT
export PLUMOS_BIOS_ROOT=${PLUMOS_BIOS_ROOT:-$PLUMOS_SDCARD_ROOT/BIOS}
export PLUMOS_IMAGE_ROOT=${PLUMOS_IMAGE_ROOT:-$PLUMOS_SDCARD_ROOT/Images}

$BB mkdir -p "$PLUMOS_ROOT/logs" "$RUNTIME_ROOT/frontend" \
    "$PLUMOS_ROOT/state/frontend" "$PLUMOS_ROOT/config/frontend" \
    "$PLUMOS_ROOT/config/system"
case "$PLUMOS_ROM_ROOT" in /storage/*) $BB mkdir -p "$PLUMOS_ROM_ROOT/FC" ;; esac
case "$PLUMOS_BIOS_ROOT" in /storage/*) $BB mkdir -p "$PLUMOS_BIOS_ROOT" ;; esac
case "$PLUMOS_IMAGE_ROOT" in /storage/*) $BB mkdir -p "$PLUMOS_IMAGE_ROOT/nes" ;; esac
printf 'frontend_start=stage-S40 device=bubble renderer=software-drm\n' >>"$LOG"
printf 'frontend_media=sdcard_root=%s rom_root=%s bios_root=%s image_root=%s\n' \
    "$PLUMOS_SDCARD_ROOT" "$PLUMOS_ROM_ROOT" "$PLUMOS_BIOS_ROOT" \
    "$PLUMOS_IMAGE_ROOT" >>"$LOG"

seed_default() {
    target=$1
    factory=$2
    if [ ! -s "$target" ]; then
        $BB cp "$factory" "$target.next"
        $BB sync
        $BB mv "$target.next" "$target"
        $BB sync
        printf 'frontend_default=seeded target=%s\n' "$target" >>"$LOG"
    else
        printf 'frontend_default=preserved target=%s\n' "$target" >>"$LOG"
    fi
}
seed_default "$PLUMOS_ROOT/config/frontend/settings.json" \
    "$PLUMOS_ROOT/factory-defaults/frontend/settings.json"
seed_default "$PLUMOS_ROOT/config/system/settings.json" \
    "$PLUMOS_ROOT/factory-defaults/system/settings.json"

printf 'frontend_scan=stage-S41\n' >>"$LOG"
PLUMOS_ROOT="$PLUMOS_ROOT" PLUMOS_SDCARD_ROOT="$PLUMOS_SDCARD_ROOT" \
    "$PLUMOS_ROOT/bin/plumos-library-scan" --defer-thumbnails >>"$LOG" 2>&1
printf 'frontend_exec=stage-S42\n' >>"$LOG"
exec "$BB" sh "$PLUMOS_ROOT/bin/plumos-controller-ui-bubble" "$@" >>"$LOG" 2>&1
