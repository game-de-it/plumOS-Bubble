+static int set_sdl2_gles1_attributes(void)
+{
+  typedef int (*sdl2_gl_set_attribute_t)(int attr, int value);
+  sdl2_gl_set_attribute_t set_attribute;
+  void *sdl2;
+
+  sdl2 = dlopen("libSDL2-2.0.so.0", RTLD_LAZY | RTLD_NOLOAD);
+  if (sdl2 == NULL)
+    sdl2 = dlopen("libSDL2-2.0.so.0", RTLD_LAZY);
+  if (sdl2 == NULL) {
+    fprintf(stderr, "failed to load SDL2 for GLES1 attributes: %s\n", dlerror());
+    return -1;
+  }
+
+  set_attribute = (sdl2_gl_set_attribute_t)dlsym(sdl2, "SDL_GL_SetAttribute");
+  if (set_attribute == NULL) {
+    fprintf(stderr, "failed to resolve SDL2 SDL_GL_SetAttribute: %s\n",
+      dlerror());
+    dlclose(sdl2);
+    return -1;
+  }
+
+  /*
+   * SDL2 SDL_GLattr values. SDL 1.2 does not expose context-version or
+   * profile attributes, so set them on the SDL2 instance used by
+   * sdl12-compat before its first SDL_SetVideoMode().
+   */
+  if (set_attribute(21, 4) != 0 ||  /* PROFILE_MASK = PROFILE_ES */
+      set_attribute(17, 1) != 0 ||  /* CONTEXT_MAJOR_VERSION */
+      set_attribute(18, 1) != 0) {  /* CONTEXT_MINOR_VERSION */
+    fprintf(stderr, "failed to request SDL2 GLES 1.1 context\n");
+    dlclose(sdl2);
+    return -1;
+  }
+
+  dlclose(sdl2);
+  return 0;
+}
