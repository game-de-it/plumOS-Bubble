 unsigned int CSVERTEX=0,CSCOLOR=0,CSTEXTURE=0;
+
+/*
+ * Keep textured client-array storage stable so compatible ordered PSX
+ * primitives can be submitted together.  Mali's GLES1 userspace driver spends
+ * substantial CPU time validating thousands of tiny draws in busy scenes.
+ *
+ * gpulib_if.c resets CSVERTEX/CSCOLOR/CSTEXTURE after display-side drawing.
+ * Treat CSVERTEX==0 as an external pointer invalidation so the first primitive
+ * of the next frame always restores the correct addresses.
+ */
+#define PLUMOS_PRIM_BATCH_MAX_VERTICES 4096
+
+static Vertex prim_vertex[PLUMOS_PRIM_BATCH_MAX_VERTICES];
+static Vertex2 prim_vertex2[PLUMOS_PRIM_BATCH_MAX_VERTICES];
+static unsigned int prim_pointer_layout;
+static int plumos_prim_batch_enabled=-1;
+static int plumos_prim_batch_kind;
+static int plumos_prim_batch_vertices;
+
+static void plumos_prim_batch_flush(void)
+{
+ if(plumos_prim_batch_vertices==0) return;
+ glDrawArrays(GL_TRIANGLES,0,plumos_prim_batch_vertices);glError();
+ plumos_prim_batch_kind=0;
+ plumos_prim_batch_vertices=0;
+}
+
+static int plumos_prim_batch_prepare(int kind,int vertices,int compatible)
+{
+ const char *setting;
+
+ if(plumos_prim_batch_enabled<0)
+  {
+   setting=getenv("PLUMOS_PCSX_GLES_BATCH");
+   plumos_prim_batch_enabled=
+    setting!=NULL && setting[0]!='\0' && strcmp(setting,"0")!=0;
+   fprintf(stderr,"Bubble GLES ordered batch: %s\n",
+           plumos_prim_batch_enabled ? "enabled" : "disabled");
+  }
+ if(!plumos_prim_batch_enabled || !compatible)
+  {
+   plumos_prim_batch_flush();
+   return 0;
+  }
+ if(plumos_prim_batch_kind!=kind ||
+    plumos_prim_batch_vertices+vertices>PLUMOS_PRIM_BATCH_MAX_VERTICES)
+  plumos_prim_batch_flush();
+ plumos_prim_batch_kind=kind;
+ return 1;
+}
+
+static void plumos_prim_batch_queue(int vertices)
+{
+ plumos_prim_batch_vertices+=vertices;
+}
 
+static void SetPrimVertexPointers(void)
+{
+ if(prim_pointer_layout==1 && CSVERTEX!=0) return;
+ glTexCoordPointer(2, GL_FLOAT, sizeof(prim_vertex[0]), &prim_vertex[0].st);glError();
+ glVertexPointer(3, GL_FLOAT, sizeof(prim_vertex[0]), &prim_vertex[0].xyz);glError();
+ prim_pointer_layout=1;
+}
+
+static void SetPrimVertex2Pointers(void)
+{
+ if(prim_pointer_layout==2 && CSVERTEX!=0) return;
+ glTexCoordPointer(2, GL_FLOAT, sizeof(prim_vertex2[0]), &prim_vertex2[0].st);glError();
+ glVertexPointer(3, GL_FLOAT, sizeof(prim_vertex2[0]), &prim_vertex2[0].xyz);glError();
+ glColorPointer(4, GL_UNSIGNED_BYTE, sizeof(prim_vertex2[0]), &prim_vertex2[0].rgba);glError();
+ prim_pointer_layout=2;
+}
