diff --git a/runner/runner.c b/runner/runner.c
index 689d67f..9ddf5fb 100644
--- a/runner/runner.c
+++ b/runner/runner.c
@@ -10,5 +10,6 @@
 #include <unistd.h>
 #include <signal.h>
+#include <string.h>
 #include <sys/types.h>
 #include <sys/stat.h>
 #include <sys/socket.h>
@@ -17,6 +18,5 @@
 
 #define SDL_DISABLE_ARM_NEON_H
 #include <SDL.h>
-#include <SDL_image.h>
 #include <GLES2/gl2.h>
 #include <SDL2/SDL.h>
@@ -27,2 +27,22 @@
 static const char *DEBUG_LEVEL_STR[] = { "FATAL", "ERROR", "DEBUG", "TRACE" };
+int nds_debug_level = ERROR_LEVEL;
+
+static int runner_debug_level(void)
+{
+    const char *level = getenv("NDS_DEBUG_LEVEL");
+
+    if (!level || !*level || !strcmp(level, "ERROR")) {
+        return ERROR_LEVEL;
+    }
+    if (!strcmp(level, "FATAL")) {
+        return FATAL_LEVEL;
+    }
+    if (!strcmp(level, "DEBUG")) {
+        return DEBUG_LEVEL;
+    }
+    if (!strcmp(level, "TRACE")) {
+        return TRACE_LEVEL;
+    }
+    return ERROR_LEVEL;
+}
 
@@ -361,5 +381,5 @@ int main(int argc, char **argv)
 {
     pthread_t id = 0;
 
-    nds_debug_level = get_debug_level(0);
+    nds_debug_level = runner_debug_level();
     trace("log level \"%s\"\n", DEBUG_LEVEL_STR[nds_debug_level]);
@@ -365,16 +385,21 @@ int main(int argc, char **argv)
 
     pthread_create(&id, NULL, runner_handler, NULL);
 
-    usleep(1500000);
+    /* Bubble can need more than one second to acquire DRM and initialize GLES.
+     * Wait for the ARMHF producer's first frame without racing the launcher's
+     * shared-memory readiness probe. */
+    for (int startup_wait = 0; startup_wait < 200 && frame_cnt == 0; startup_wait++) {
+        usleep(50000);
+    }
 
     if (frame_cnt == 0) {
         running = 0;
         error("no receive any frame from emulator\n");
 
 #if defined(TRIMUI_BRICK)
