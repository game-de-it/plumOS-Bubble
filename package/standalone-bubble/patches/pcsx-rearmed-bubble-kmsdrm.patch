 // FEED SOUND DATA
+static const int16_t *resample_audio(const int16_t *input,
+ snd_pcm_uframes_t frames, snd_pcm_uframes_t *output_frames)
+{
+ const uint64_t output_rate = resample_output_rate;
+ uint64_t limit;
+ size_t needed;
+ snd_pcm_uframes_t produced = 0;
+
+ if (resample_input_rate == output_rate || frames == 0)
+  {
+   *output_frames = frames;
+   return input;
+  }
+ if (!resample_have_previous)
+  {
+   resample_previous[0] = input[0];
+   resample_previous[1] = input[1];
+   resample_have_previous = 1;
+   input += 2;
+   frames--;
+   if (frames == 0)
+    {
+     *output_frames = 0;
+     return input;
+    }
+  }
+ needed = (size_t)(((uint64_t)frames * output_rate + resample_phase +
+  resample_input_rate - 1) / resample_input_rate + 2);
+ if (needed > resample_capacity)
+  {
+   int16_t *resized = realloc(resample_buffer, needed * 2 * sizeof(*resized));
+   if (resized == NULL)
+    {
+     *output_frames = frames;
+     return input;
+    }
+   resample_buffer = resized;
+   resample_capacity = needed;
+  }
+ limit = (uint64_t)frames * output_rate;
+ while (resample_phase < limit)
+  {
+   snd_pcm_uframes_t index = (snd_pcm_uframes_t)(resample_phase / output_rate);
+   uint64_t fraction = resample_phase % output_rate;
+   const int16_t *before = index == 0 ? resample_previous : input + (index - 1) * 2;
+   const int16_t *after = input + index * 2;
+   int channel;
+
+   for (channel = 0; channel < 2; channel++)
+    {
+     int64_t mixed = (int64_t)before[channel] *
+      (int64_t)(output_rate - fraction) +
+      (int64_t)after[channel] * (int64_t)fraction;
+     resample_buffer[produced * 2 + channel] =
+      (int16_t)(mixed / (int64_t)output_rate);
+    }
+   produced++;
+   resample_phase += resample_input_rate;
+  }
+ resample_phase -= limit;
+ resample_previous[0] = input[(frames - 1) * 2];
+ resample_previous[1] = input[(frames - 1) * 2 + 1];
+ *output_frames = produced;
+ return resample_buffer;
+}
