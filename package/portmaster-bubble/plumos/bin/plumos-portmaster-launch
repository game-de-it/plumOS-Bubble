#!/bin/sh
set -u

if [ "${PLUMOS_PORTMASTER_BUSYBOX_REEXEC:-0}" != 1 ]; then
  early_busybox="${PLUMOS_BUSYBOX:-/bin/busybox}"
  if [ -x "$early_busybox" ]; then
    export PLUMOS_PORTMASTER_BUSYBOX_REEXEC=1
    exec "$early_busybox" sh "$0" "$@"
  fi
fi

PLUMOS_ROOT="${PLUMOS_ROOT:-/storage/plumos}"
PLUMOS_SDCARD_ROOT="${PLUMOS_SDCARD_ROOT:-/storage}"
PLUMOS_ROM_ROOT="${PLUMOS_ROM_ROOT:-$PLUMOS_SDCARD_ROOT/Roms}"
RUN_ROOT="${PLUMOS_PORTMASTER_RUN_ROOT:-/run/plumos/portmaster}"
BB="${PLUMOS_BUSYBOX:-/bin/busybox}"
APP_ROOT="${PLUMOS_PORTMASTER_APP_ROOT:-${PLUMOS_ROOT}/apps/portmaster}"
ADAPTER_DIR="${APP_ROOT}/adapter"
STATE_ROOT="${PLUMOS_ROOT}/state/portmaster"
DATA_ROOT="${PLUMOS_PORTMASTER_DATA_ROOT:-${STATE_ROOT}/data}"
PM_DIR="${DATA_ROOT}/upstream/PortMaster"
RESTART_FILE="${PM_DIR}/.pugwash-reboot"
LOG_FILE="${PLUMOS_ROOT}/logs/apps/portmaster.log"
PID_FILE="${RUN_ROOT}/portmaster.pid"
MOUNTS_FILE="${RUN_ROOT}/state.mounts"
MOUNT_CLEANUP="${PLUMOS_ROOT}/bin/plumos-portmaster-mount-cleanup"
FRONTEND_CONTROL="${PLUMOS_ROOT}/bin/plumos-portmaster-frontend-control"
child_pid=""
restore_frontend=0
cleanup_done=0
[ -x "$BB" ] || BB=/bin/busybox

frontend_is_ancestor() {
  parent=$PPID
  count=0
  while [ "$parent" -gt 1 ] 2>/dev/null && [ "$count" -lt 16 ]; do
    cmdline="$(tr '\000' ' ' < "/proc/${parent}/cmdline" 2>/dev/null || true)"
    case "$cmdline" in
      *plumos-controller-ui-bubble*|*plumos-controller-ui-fbdev*) return 0 ;;
    esac
    parent="$(sed 's/.*) //' "/proc/${parent}/stat" 2>/dev/null | awk '{print $2}' || true)"
    case "$parent" in ''|*[!0-9]*) return 1 ;; esac
    count=$((count + 1))
  done
  return 1
}

frontend_running() {
  [ -x "$FRONTEND_CONTROL" ] &&
    "$BB" sh "$FRONTEND_CONTROL" status >/dev/null 2>&1
}

is_mounted() {
  awk -v path="$1" \
    'tolower($5) == tolower(path) { found=1 } END { exit !found }' \
    /proc/self/mountinfo
}

cleanup() {
  [ "$cleanup_done" -eq 0 ] || return 0
  cleanup_done=1
  if [ -x "$MOUNT_CLEANUP" ]; then
    "$BB" sh "$MOUNT_CLEANUP" "$MOUNTS_FILE" \
      "${PM_DIR}/pugwash.txt" \
      "${PM_DIR}/config" "${PM_DIR}/libs" "${PM_DIR}/themes" \
      >> "$LOG_FILE" 2>&1 || true
  fi
  recorded="$(cat "$PID_FILE" 2>/dev/null || true)"
  if [ -n "$child_pid" ] && [ "$recorded" = "$child_pid" ]; then
    rm -f "$PID_FILE"
  fi
  # Port installs can replace thousands of FAT32 entries. Finish that write
  # boundary before returning control to the frontend or accepting a reboot.
  sync
  if [ "$restore_frontend" -eq 1 ]; then
    "$BB" sh "$FRONTEND_CONTROL" release >> "$LOG_FILE" 2>&1 || true
  fi
}

terminate_child() {
  [ -n "$child_pid" ] || return 0
  cmdline="$(tr '\000' ' ' < "/proc/${child_pid}/cmdline" 2>/dev/null || true)"
  case "$cmdline" in
    *plumos_portmaster_bootstrap.py*) kill -TERM "$child_pid" 2>/dev/null || true ;;
  esac
}

trap cleanup EXIT
trap terminate_child HUP INT TERM

mkdir -p "$RUN_ROOT" "$STATE_ROOT/config" "$STATE_ROOT/libs" \
  "$STATE_ROOT/themes" "$STATE_ROOT/home" "$(dirname "$LOG_FILE")"

if [ -f "$PID_FILE" ]; then
  old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  old_cmd="$(tr '\000' ' ' < "/proc/${old_pid}/cmdline" 2>/dev/null || true)"
  case "$old_pid:$old_cmd" in
    *:*plumos_portmaster_bootstrap.py*)
      printf 'plumos-portmaster-launch: already running pid=%s\n' "$old_pid" >&2
      exit 75
      ;;
  esac
  rm -f "$PID_FILE"
fi

[ -x "$MOUNT_CLEANUP" ] || {
  printf 'plumos-portmaster-launch: mount cleanup helper is missing: %s\n' \
    "$MOUNT_CLEANUP" >&2
  exit 127
}
"$BB" sh "$MOUNT_CLEANUP" "$MOUNTS_FILE" \
  "${PM_DIR}/pugwash.txt" \
  "${PM_DIR}/config" "${PM_DIR}/libs" "${PM_DIR}/themes" \
  >> "$LOG_FILE" 2>&1 || exit 1

"$BB" sh "${PLUMOS_ROOT}/bin/plumos-portmaster-runtime" prepare >/dev/null || exit 1

: > "$MOUNTS_FILE"
upstream_log="${PLUMOS_ROOT}/logs/apps/portmaster-upstream.log"
upstream_log_target="${PM_DIR}/pugwash.txt"
touch "$upstream_log" "$upstream_log_target"
if is_mounted "$upstream_log_target"; then
  printf 'plumos-portmaster-launch: stale log mount: %s\n' "$upstream_log_target" >&2
  exit 1
fi
mount --bind "$upstream_log" "$upstream_log_target" || exit 1
printf '%s\n' "$upstream_log_target" >> "$MOUNTS_FILE"
for name in config libs themes; do
  source_dir="${STATE_ROOT}/${name}"
  target_dir="${PM_DIR}/${name}"
  mkdir -p "$source_dir" "$target_dir"
  if is_mounted "$target_dir"; then
    printf 'plumos-portmaster-launch: stale state mount: %s\n' "$target_dir" >&2
    exit 1
  fi
  mount --bind "$source_dir" "$target_dir" || exit 1
  printf '%s\n' "$target_dir" >> "$MOUNTS_FILE"
done

audio_output="${PLUMOS_ROOT}/bin/plumos-audio-output"
if [ -x "$audio_output" ]; then
  "$BB" sh "$audio_output" prepare >>"$LOG_FILE" 2>&1 || {
    printf 'plumos-portmaster-launch: audio route preparation failed\n' >&2
    exit 1
  }
  audio_status="$(tr '\n' ' ' </run/plumos/audio/output.status)"
  export ALSA_CONFIG_PATH="/run/plumos/audio/asound.conf"
  export AUDIODEV="plumos_output"
else
  audio_status="router=direct-hw device=default"
  export ALSA_CONFIG_PATH="${PLUMOS_ROOT}/share/alsa/alsa.conf"
  export AUDIODEV="default"
fi
if [ -x "${PLUMOS_ROOT}/bin/plumos-volume-control" ]; then
  "$BB" sh "${PLUMOS_ROOT}/bin/plumos-volume-control" apply \
    >>"$LOG_FILE" 2>&1 || true
fi

cfw_version="$(cat "${PLUMOS_ROOT}/VERSION" 2>/dev/null || printf 'unknown')"
export PLUMOS_ROOT PLUMOS_SDCARD_ROOT PLUMOS_ROM_ROOT
export PLUMOS_PORTMASTER_APP_ROOT="$APP_ROOT"
export PLUMOS_PORTMASTER_DATA_ROOT="$DATA_ROOT"
export PLUMOS_PORTMASTER_CFW_VERSION="$cfw_version"
export HOME="${STATE_ROOT}/home"
export XDG_CONFIG_HOME="${STATE_ROOT}/config"
export XDG_CACHE_HOME="${RUN_ROOT}/cache"
export XDG_DATA_HOME="${DATA_ROOT}/upstream"
export HM_TOOLS_DIR="${DATA_ROOT}/upstream"
export HM_PORTS_DIR="${PLUMOS_ROM_ROOT}/PORTS"
export HM_SCRIPTS_DIR="${PLUMOS_ROM_ROOT}/PORTS"
export PATH="${ADAPTER_DIR}/shims:${RUN_ROOT}/busybox-bin:${ADAPTER_DIR}/bin/aarch64:${PLUMOS_ROOT}/bin:${PATH}"
export LD_LIBRARY_PATH="${RUN_ROOT}/lib:${PLUMOS_ROOT}/apps/pyxel/lib:${PLUMOS_ROOT}/apps/python/lib:${PLUMOS_ROOT}/lib:${PLUMOS_ROOT}/apps/nextcommander/lib:${PLUMOS_ROOT}/emulator/lib:${PLUMOS_ROOT}/apps/pyxel/site/pygame.libs:${LD_LIBRARY_PATH:-}"
# Keep vendor GBM ahead of the Mesa GBM copies carried by utility apps. SDL's
# KMSDRM backend opens libgbm independently of its EGL/GL driver hints; mixing
# Mesa GBM with Bubble's stateful Mali EGL/GLES DSO fails window creation.
export PLUMOS_BUBBLE_PYTHON_EXTRA_LIBRARY_PATH="${PLUMOS_ROOT}/emulator/lib:${RUN_ROOT}/lib:${PLUMOS_ROOT}/lib:${PLUMOS_ROOT}/apps/nextcommander/lib:${PLUMOS_ROOT}/apps/pyxel/site/pygame.libs"
export PYSDL2_DLL_PATH="${RUN_ROOT}/lib"
export SDL_VIDEODRIVER="kmsdrm"
export SDL_RENDER_DRIVER="opengles2"
export SDL_AUDIODRIVER="alsa"
[ ! -d "${PLUMOS_ROOT}/lib/alsa-lib" ] ||
  export ALSA_PLUGIN_DIR="${PLUMOS_ROOT}/lib/alsa-lib"
export SDL_GAMECONTROLLERCONFIG_FILE="${RUN_ROOT}/gamecontrollerdb.txt"
export SDL_GAMECONTROLLERCONFIG="$(cat "$SDL_GAMECONTROLLERCONFIG_FILE")"
export SDL_VIDEO_KMSDRM_DEVICE_INDEX="${SDL_VIDEO_KMSDRM_DEVICE_INDEX:-0}"
mali_library="${PLUMOS_ROOT}/emulator/lib/libmali.so.1"
[ -c /dev/mali0 ] && [ -r "$mali_library" ] || {
  printf 'plumos-portmaster-launch: Bubble Mali hardware runtime is unavailable\n' >&2
  exit 1
}
export SDL_VIDEO_EGL_DRIVER="${SDL_VIDEO_EGL_DRIVER:-$mali_library}"
export SDL_VIDEO_GL_DRIVER="${SDL_VIDEO_GL_DRIVER:-$mali_library}"
# The explicit glibc loader used by plumos-python-bubble resolves PySDL2's
# process-wide EGL/GLES symbols before SDL's driver hints can disambiguate the
# stock Mesa libraries.  Bubble's vendor stack is one stateful mega-DSO, so
# preload that exact file inside the managed Python process.  This is the same
# canonical-library rule used by the working Pyxel and PPSSPP paths and does
# not enable a software fallback.
export PLUMOS_BUBBLE_PYTHON_LD_PRELOAD="$mali_library${PLUMOS_BUBBLE_PYTHON_LD_PRELOAD:+:$PLUMOS_BUBBLE_PYTHON_LD_PRELOAD}"
unset LIBGL_ALWAYS_SOFTWARE MESA_LOADER_DRIVER_OVERRIDE \
  LIBGL_DRIVERS_PATH __EGL_VENDOR_LIBRARY_FILENAMES
mkdir -p "$HOME" "$XDG_CACHE_HOME" "$HM_PORTS_DIR"
for helper in pgrep pkill; do
  command -v "$helper" >/dev/null 2>&1 || {
    printf 'plumos-portmaster-launch: GUI helper is missing: %s\n' "$helper" >&2
    exit 127
  }
done

# Do this while the frontend still owns its renderer on direct launches.  A
# missing transitive DSO must fail back to the menu instead of producing a
# long black screen after display handoff.
if ! "$BB" sh "${PLUMOS_ROOT}/bin/plumos-python-bubble" -c \
  'import ctypes; ctypes.CDLL("libSDL2_image-2.0.so.0"); ctypes.CDLL("libSDL2_mixer-2.0.so.0"); ctypes.CDLL("libSDL2_ttf-2.0.so.0")' \
  >> "$LOG_FILE" 2>&1; then
  printf 'plumos-portmaster-launch: GUI runtime preflight failed; see %s\n' \
    "$LOG_FILE" >&2
  exit 70
fi

if ! frontend_is_ancestor && frontend_running; then
  "$BB" sh "$FRONTEND_CONTROL" acquire >> "$LOG_FILE" 2>&1 || exit 1
  restore_frontend=1
fi

printf '\n[%s] launch version=%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
  "$(cat "${PM_DIR}/version" 2>/dev/null || printf unknown)" \
  "$(printf '%s' "$audio_status" | tr '\n' ' ')" >> "$LOG_FILE"
printf 'renderer=mali-g52-gles2 software_fallback=false\n' >>"$LOG_FILE"

# Preserve PortMaster.sh's outer restart contract.  Language, theme and
# release-channel changes request a GUI restart using this marker.  A stale
# marker left by an interrupted session must not suppress every later launch.
if [ -e "$RESTART_FILE" ]; then
  printf '[%s] restart-marker=stale action=consume\n' \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >> "$LOG_FILE"
  rm -f "$RESTART_FILE" || exit 1
fi

restart_limit="${PLUMOS_PORTMASTER_RESTART_LIMIT:-8}"
case "$restart_limit" in
  ''|*[!0-9]*|0)
    printf 'plumos-portmaster-launch: invalid restart limit: %s\n' \
      "$restart_limit" >&2
    exit 64
    ;;
esac
restart_count=0

while :; do
  "$BB" sh "${PLUMOS_ROOT}/bin/plumos-python-bubble" \
    "${ADAPTER_DIR}/plumos_portmaster_bootstrap.py" "$@" >> "$LOG_FILE" 2>&1 &
  child_pid=$!
  printf '%s\n' "$child_pid" > "$PID_FILE"
  wait "$child_pid"
  rc=$?

  [ -e "$RESTART_FILE" ] || exit "$rc"
  rm -f "$RESTART_FILE" || exit 1
  restart_count=$((restart_count + 1))
  printf '[%s] restart-marker=requested count=%s rc=%s\n' \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$restart_count" "$rc" \
    >> "$LOG_FILE"
  if [ "$restart_count" -ge "$restart_limit" ]; then
    printf 'plumos-portmaster-launch: restart limit reached: %s\n' \
      "$restart_limit" >&2
    exit 75
  fi
done
