# Game Gear LCD
#
# Reproduces the panel in a real Game Gear rather than a generic "LCD" look.
# Two passes, because the two things that make that screen recognisable happen
# at different rates:
#
#   1. response - the STN panel is slow, so movement smears, and it falls to
#      dark more slowly than it rises to light.  Run at source resolution.
#   2. panel    - RGB stripe subpixels, the gap between cells, the washed out
#      contrast of an STN gamut, and the uneven CCFL edge light.  Run at the
#      output resolution so the stripe lands on real pixels.
#
# GLSL rather than slang: this device's RetroArch is built --enable-opengles
# --disable-opengl_core, so the slang path does not exist here.

shaders = "3"

shader0 = "gamegear-lcd-response.glsl"
filter_linear0 = "false"
scale_type0 = "source"
scale0 = "1.0"
float_framebuffer0 = "false"
# The panel pass reads one texel either side of centre for its diffusion, so
# the frame's own border must repeat rather than fall off into black.
wrap_mode0 = "clamp_to_edge"

shader1 = "gamegear-lcd-panel.glsl"
filter_linear1 = "false"
scale_type1 = "viewport"
scale1 = "1.0"
wrap_mode1 = "clamp_to_edge"

shader2 = "gamegear-lcd-optics.glsl"
filter_linear2 = "false"
scale_type2 = "viewport"
scale2 = "1.0"
wrap_mode2 = "clamp_to_edge"
